vamos cut test: a bidirectional SPICE pad with a tri-state driver and a pull-up

// tb.pad: 'assign pad = en ? d : 1'bz', a Verilog pullup (moved into the deck:
// the gated D2A pulls toward HIV with enable WF whenever no strong driver is
// active) and a reader.  The pad cell has a 20k pull-down, so a released pad
// sits at 1.8*20k/(20k+3500.2) = 1.532 V and reads 1.
load "gcond.osdi"
load "resistor.osdi"
model vsrc vsource
model isrc isource
model r resistor
model gc vamos_gcond rr=500.7

subckt pad_sp (pad)
  rpd (pad 0) r r=20k
ends

xv_u1 (n_u1_pad) pad_sp

vd_n_u1_pad (n_u1_pad_d 0) vsrc type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:d2a:tb.u1.pad__d"
ve_n_u1_pad (n_u1_pad_e 0) vsrc type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:d2a:tb.u1.pad__e"
g_n_u1_pad (n_u1_pad n_u1_pad_d n_u1_pad_e) gc
ia_n_u1_pad (n_u1_pad 0) isrc type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:a2d:tb.u1.pad__a"
rsh_n_u1_pad (n_u1_pad 0) r r=1e12

control
  options tran_lteimplicit=0
  analysis tran1 tran step=0.1n stop=95n
endc
