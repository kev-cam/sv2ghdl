vamos emitter golden: basic
// generated by vamos
ground 0
load "spice/mos1.osdi"
load "spice/diode.osdi"
load "spice/bjt.osdi"
load "spice/jfet1.osdi"
load "resistor.osdi"
load "capacitor.osdi"
load "spice/resistor.osdi"
load "inductor.osdi"
model vamos_resistor resistor
model vamos_capacitor capacitor
model vamos_vsource vsource
model vamos_sp_resistor sp_resistor
model vamos_vcvs vcvs
model vamos_vccs vccs
model vamos_cccs cccs
model vamos_ccvs ccvs
model vamos_inductor inductor
model vamos_mutual mutual
model vamos_isource isource
parameters vdd=1.8
parameters wn=1e-06
parameters gain=vdd/0.9
model m_nch sp_mos1 type=1.0 vto=0.5 kp=0.0001 lambda=0.02 gamma=0.5276252190748421 phi=0.5760365037084703
model m_pch sp_mos1 type=-1.0 vto=-0.5 kp=4e-05 lambda=0.02 gamma=0.5276252190748421 phi=0.5760365037084703
model m_dd sp_diode level=1.0 is=1e-14 cjo=1e-12 fc=0.0 vj=0.8
model m_qn sp_bjt type=1.0 is=1e-15 bf=100.0
model m_jn sp_jfet1 type=1.0 vto=-2.0 beta=0.0001
subckt inv (a y vdd)
  parameters wp=2.4999999999999998e-06
  parameters $mfactor=1.0
  mn (y a ns 0) m_nch w=wn l=1e-06 $mfactor=$mfactor
  rsrc (ns 0) vamos_resistor r=10.0 $mfactor=$mfactor
  mp (y a vdd vdd) m_pch w=wp l=1e-06 $mfactor=$mfactor
  cy (y 0) vamos_capacitor c=1e-14 $mfactor=$mfactor
ends
vsup (vdd 0) vamos_vsource dc=vdd
vin (in 0) vamos_vsource type="pulse" val0=0.0 val1=vdd delay=1e-09 rise=1e-10 fall=1e-10 width=4e-09 period=1e-08
x1 (in out vdd) inv wp=3e-06
x2 (out out2 vdd) inv $mfactor=2.0
rl (out2 0) vamos_resistor r=100000.0
r1 (vdd rb) vamos_sp_resistor r=10000.0 tc1=0.001
d1 (rb 0) m_dd
vsin (s 0) vamos_vsource type="sine" sinedc=0.5 ampl=0.2 freq=100000000.0 delay=1e-09 theta=0.0 tdphase=0.0
rs (s sb) vamos_resistor r=1000.0
q1 (sb sb 0 0) m_qn
vexp (e 0) vamos_vsource type="exp" val0=0.0 val1=1.0 delay=1e-09 tau1=1e-09 td2=1.9999999999999997e-09 tau2=1e-09
re (e 0) vamos_resistor r=1000.0
vpwl (p 0) vamos_vsource type="pwl" wave=[0.0, 0.0, 1e-09, 1.0, 2e-09, 0.5] delay=5e-10
rp (p 0) vamos_resistor r=1000.0
vj (jd 0) vamos_vsource dc=1.0
j1 (jd 0 0) m_jn
e1 (ea 0 out 0) vamos_vcvs gain=gain
rea (ea 0) vamos_resistor r=1000.0
g1 (0 ga out 0) vamos_vccs gain=0.001
rga (ga 0) vamos_resistor r=1000.0
vprobe (vdd vp) vamos_vsource dc=0.0
rvp (vp 0) vamos_resistor r=10000.0
f1 (0 fa) vamos_cccs gain=2.0 ctlinst="vprobe"
rfa (fa 0) vamos_resistor r=1000.0
h1 (ha 0) vamos_ccvs gain=1000.0 ctlinst="vprobe"
rha (ha 0) vamos_resistor r=1000.0
ebeh (bb 0) v=v(out)*0.5
gbeh (0 bc) i=0.001*v(in)
rbb (bb 0) vamos_resistor r=1000.0
rbc (bc 0) vamos_resistor r=1000.0
vl (la 0) vamos_vsource type="sine" sinedc=0.0 ampl=1.0 freq=10000000.0 delay=0.0 theta=0.0 tdphase=0.0
l1 (la lb) vamos_inductor l=1e-06
l2 (lc 0) vamos_inductor l=4e-06
k1 () vamos_mutual k=0.5 ind1="l1" ind2="l2"
rlb (lb 0) vamos_resistor r=10.0
rlc (lc 0) vamos_resistor r=100.0
i1 (0 ib) vamos_isource dc=1e-06
rib (ib 0) vamos_resistor r=1000.0
control
  abort always
  options tran_lteimplicit=0 temp=25.0 tnom=25.0
  save v(out) v(out2) i(vsup) v('x1:ns') v(bc) v(fa) v(ha)
  analysis vamos_tran tran step=1e-11 stop=2e-08
endc
