vamos ams deck
// generated by vamos
ground 0
load "/vamos/ams/va/0_vamos_ie.osdi"
load "spice/mos1.osdi"
load "capacitor.osdi"
load "resistor.osdi"
model vamos_capacitor capacitor
model vamos_vsource vsource
model vamos_gcond vamos_gcond
model vamos_resistor resistor
model vamos_isource isource
model m_nch sp_mos1 type=1.0 vto=0.5 kp=0.0001 lambda=0.02 gamma=0.5276252190748421 phi=0.5760365037084703 cj=0.00010185098195480395 fc=0.0
model m_pch sp_mos1 type=-1.0 vto=-0.5 kp=4e-05 lambda=0.02 gamma=0.5276252190748421 phi=0.5760365037084703 cj=0.00010185098195480395 fc=0.0
subckt inv (a y vdd)
  parameters $mfactor=1.0
  mn (y a 0 0) m_nch w=1e-06 l=1e-06 $mfactor=$mfactor
  mp (y a vdd vdd) m_pch w=2.5e-06 l=1e-06 $mfactor=$mfactor
  cy (y 0) vamos_capacitor c=1e-14 $mfactor=$mfactor
ends
vd_n_u_a (n_u_a_d 0) vamos_vsource type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:d2a:tb.u.a__d"
ve_n_u_a (n_u_a_e 0) vamos_vsource type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:d2a:tb.u.a__e"
g_n_u_a (n_u_a n_u_a_d n_u_a_e) vamos_gcond rr=500.7
rsh_n_u_a (n_u_a 0) vamos_resistor r=1000000000000.0
ia_n_u_y (n_u_y 0) vamos_isource type="pwl" file="code:libcosim_bridge.so:vacask_bridge_init:a2d:tb.u.y__a"
rsh_n_u_y (n_u_y 0) vamos_resistor r=1000000000000.0
vs_n_vdd (n_vdd 0) vamos_vsource dc=1.8
xv_u (n_u_a n_u_y n_vdd) inv
control
  abort always
  options tran_lteimplicit=0 temp=25.0 tnom=25.0
  save v(n_u_a) v(n_u_y)
  analysis vamos_tran tran step=1e-11 stop=1e-06 maxstep=1e-08
endc
