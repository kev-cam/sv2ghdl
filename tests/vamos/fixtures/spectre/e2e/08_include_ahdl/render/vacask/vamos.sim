// e2e 8: include section= of a library file, ahdl_include of Verilog-A resistors
// generated by vamos
ground 0
load "vares.va"
load "vres.va"
load "spice/resistor.osdi"
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model m_rmod sp_resistor
V1 (a 0) vamos_vsource type="dc" dc=1.0
model X1__va vares r=3000.0
X1 (a b) X1__va
R2 (b 0) vamos_resistor r=1000.0
model X2__va vres
X2 (a c) X2__va
R3 (c 0) vamos_resistor r=1000.0
R4 (a d) m_rmod r=3000.0
R5 (d 0) vamos_resistor r=1000.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(b) v(c) v(d)
  analysis vamos_a1 op
endc
