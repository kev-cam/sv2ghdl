// e2e 18: initial conditions (sec. 5.4): ic statements under each tran ic mode, skipdc, a nodeset; the op and ac unchanged
// generated by vamos
ground 0
load "resistor.osdi"
load "capacitor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_capacitor capacitor
V1 (in 0) vamos_vsource type="dc" dc=1.0 mag=1.0 phase=0.0
R1 (in a) vamos_resistor r=1000.0
C1 (a 0) vamos_capacitor c=1e-09
R2 (in b) vamos_resistor r=1000.0
C2 (b 0) vamos_capacitor c=1e-09
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(in) v(a) v(b)
  analysis vamos_a1 op nodeset={"a", 0.5, "b", 0.5}
  clear saves
  save dv(in) dv(a) dv(b)
  analysis vamos_a2 ac values=[1000.0] nodeset={"a", 0.5, "b", 0.5}
  clear saves
  save v(in) v(a) v(b)
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a3 tran step=9.999999999999999e-11 stop=1e-07 maxstep=1.9999999999999997e-09 ic={"a", 0.2, "b", 0.4} nodeset={"a", 0.5, "b", 0.5}
  options relref="alllocal"
  options relref="sigglobal"
  analysis vamos_a4 tran step=9.999999999999999e-11 stop=1e-07 maxstep=1.9999999999999997e-09 ic={"a", 0.2, "b", 0.4} nodeset={"a", 0.5, "b", 0.5}
  options relref="alllocal"
  options relref="sigglobal"
  analysis vamos_a5 tran step=9.999999999999999e-11 stop=1e-07 maxstep=1.9999999999999997e-09 nodeset={"a", 0.5, "b", 0.5}
  options relref="alllocal"
  options relref="sigglobal"
  analysis vamos_a6 tran step=9.999999999999999e-11 stop=1e-07 maxstep=1.9999999999999997e-09 nodeset={"a", 0.5, "b", 0.5}
  options relref="alllocal"
  options relref="sigglobal"
  analysis vamos_a7 tran step=9.999999999999999e-11 stop=1e-07 maxstep=1.9999999999999997e-09 icmode="uic" ic={"a", 0.2, "b", 0.4} nodeset={"a", 0.5, "b", 0.5}
  options relref="alllocal"
endc
