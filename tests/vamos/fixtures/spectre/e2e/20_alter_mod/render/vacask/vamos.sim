// e2e 20: alter mod= (sec. 5.3, sec. 7.2): the Xyce state replay prints the altered cards in every later deck
// generated by vamos
ground 0
load "spice/diode.osdi"
model vamos_isource isource
I1 (0 d) vamos_isource type="dc" dc=0.001
D1 (d 0) m_dm
model m_dm sp_diode level=1.0 is=1e-14 eg=1.124481
I2 (d2 0) vamos_isource type="dc" dc=0.001
D2 (d2 0) m_dz
model m_dz sp_diode level=1.0 is=1e-14 bv=5.0 eg=1.124481
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(d) v(d2)
  analysis vamos_a1 op
  alter model("m_dm") is=1e-13
  alter model("m_dz") bv=3.0
  analysis vamos_a2 op
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a3 tran step=9.999999999999999e-10 stop=1e-06 maxstep=2e-08
  options relref="alllocal"
endc
