// e2e 10: UG p.110: an inline subckt binning BJT cards by area with same-named branches
// generated by vamos
ground 0
load "spice/bjt.osdi"
model vamos_vsource vsource
subckt npn_mod (c b e s)
  parameters area=1e-12
  parameters $mfactor=1.0
  @if real(area<1e-10)
    npn_mod (vamos_tn2 b e s) m_npn10x10 $mfactor=$mfactor
  @else
    @if real(area<4e-10)
      npn_mod (vamos_tn1 b e s) m_npn20x20 $mfactor=$mfactor
    @else
      npn_mod (vamos_tn3 b e s) m_npn_default $mfactor=$mfactor
    @end
  @end
  model m_npn10x10 sp_bjt type=1.0 is=3.5e-16 vaf=61.5 mje=0.3333333333333333 mjc=0.3333333333333333 fc=0.5
  model m_npn20x20 sp_bjt type=1.0 is=3.77e-16 vaf=60.5 mje=0.3333333333333333 mjc=0.3333333333333333 fc=0.5
  model m_npn_default sp_bjt type=1.0 is=3.2e-16 vaf=59.8 mje=0.3333333333333333 mjc=0.3333333333333333 fc=0.5
  vamos_tp1 (c vamos_tn1) vamos_vsource type="dc" dc=0.0
  vamos_tp2 (c vamos_tn2) vamos_vsource type="dc" dc=0.0
  vamos_tp3 (c vamos_tn3) vamos_vsource type="dc" dc=0.0
ends
vin (1 0) vamos_vsource type="dc" dc=1.0
vb (2 0) vamos_vsource type="dc" dc=0.7
vb3 (3 0) vamos_vsource type="dc" dc=0.65
q1 (1 2 0 0) npn_mod area=3.5e-10
q2 (1 3 0 0) npn_mod area=2.5e-11
q3 (1 3 0 0) npn_mod area=1e-09
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default
  analysis vamos_a1 op
  sweep vamos_w1 instance="q1" parameter="area" values=[1.5e-10, 3.5e-10] continuation=1
    analysis vamos_a2 op
endc
