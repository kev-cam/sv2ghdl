// e2e 2: dc sweeps of a source, temp, a top-level parameter, a model parameter, a subckt parameter
// generated by vamos
ground 0
load "resistor.osdi"
load "spice/diode.osdi"
load "spice/bsim3v3.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
parameters rtop=vamos_v_rtop
V1 (in 0) vamos_vsource type="dc" dc=1.0
R1 (in mid) vamos_resistor r=rtop
X1 (mid out) cell r=1000.0
X2 (out 0) cell r=1000.0
X3 (out 0) cell2
subckt cell (a b)
  parameters r=1000.0
  parameters $mfactor=1.0
  R1 (a b) vamos_resistor r=r $mfactor=$mfactor
ends
subckt cell2 (a b)
  parameters $mfactor=1.0
  R1 (a b) vamos_resistor r=2000.0 $mfactor=$mfactor
ends
Vd (d 0) vamos_vsource type="dc" dc=1.0
Rd (d da) vamos_resistor r=100.0
D1 (da 0) m_dm
model m_dm sp_diode level=1.0 is=1e-14 n=1.0 nbv=1.0 eg=1.124481
Vg (g 0) vamos_vsource type="dc" dc=1.2
Vm (dm 0) vamos_vsource type="dc" dc=1.2
M1 (dm g 0 0) m_nch w=2e-06 l=5e-07 nrd=0.0 nrs=0.0
model m_nch sp_bsim3v3 type=1.0 vth0=0.4 tox=4e-09 toxm=4e-09 u0=0.04 capmod=2.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_rtop=1000.0
  save v(out) v(da) i(V1) i(Vd) i(Vm) p('X2:R1', i) p('X3:R1', i)
  analysis vamos_a1 op
  sweep vamos_w1 instance="V1" parameter="dc" from=0.0 to=2.0 step=0.5 continuation=1
    analysis vamos_a2 op
  sweep vamos_w2 option="temp" from=0.0 to=100.0 step=50.0 continuation=1
    analysis vamos_a3 op
  sweep vamos_w3 variable="vamos_v_rtop" values=[1000.0, 2000.0, 3000.0] continuation=1
    analysis vamos_a4 op
  sweep vamos_w4 model="m_nch" parameter="vth0" values=[0.4, 0.5, 0.6] continuation=1
    analysis vamos_a5 op
  sweep vamos_w5 instance="X2" parameter="r" values=[1000.0, 2000.0] continuation=1
    analysis vamos_a6 op
  sweep vamos_w6 instance="X3:R1" parameter="r" values=[1000.0, 2000.0, 4000.0] continuation=1
    analysis vamos_a7 op
  analysis vamos_a8 op
endc
