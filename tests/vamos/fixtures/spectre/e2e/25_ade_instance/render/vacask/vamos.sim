ground 0
load "resistor.osdi"
load "capacitor.osdi"
model vamos_resistor resistor
model vamos_capacitor capacitor
model vamos_vsource vsource
subckt divider (in out)
  parameters $mfactor=1.0
  r3 (in Mid) vamos_resistor r=1000.0 $mfactor=$mfactor
  r4 (Mid out) vamos_resistor r=1000.0 $mfactor=$mfactor
  C0 (Mid 0) vamos_capacitor c=1e-09 $mfactor=$mfactor
ends
I2 (net1 out) divider
R0 (out 0) vamos_resistor r=2000.0
V0 (net1 0) vamos_vsource type="dc" dc=1.0 mag=1.0 phase=0.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default
  analysis vamos_a1 op
  clear saves
  save nc(R0) nc('I2:r3') nc('I2:r4')
  analysis vamos_a2 noise out="out" in="V0" from=1.0 to=100.0 mode="dec" points=1
  clear saves
  save default
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a3 tran step=5e-09 stop=5e-06 maxstep=1.0000000000000001e-07 ic={"I2:Mid", 0.3}
  options relref="alllocal"
endc
