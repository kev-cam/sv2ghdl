Vd8 d8 0 DC 1.2
M1 d1 g 0 0 nch.1 w=5e-07 l=5e-07 nrd=0.0 nrs=0.0
M2 d2 g 0 0 nch.2 w=5e-07 l=2e-06 nrd=0.0 nrs=0.0
M3 d3 g 0 0 nch.3 w=2e-06 l=5e-07 nrd=0.0 nrs=0.0
M4 d4 g 0 0 nch.4 w=2e-06 l=1e-06 nrd=0.0 nrs=0.0
M5 d5 g 0 0 b4ref w=2e-06 l=1e-06 nrd=0.0 nrs=0.0
M6 d6 g 0 0 nch.4 w=5e-06 l=5e-06 nrd=0.0 nrs=0.0
M7 d7 g 0 0 b4ref w=5e-06 l=5e-06 nrd=0.0 nrs=0.0
M8 d8 g 0 0 b1ref w=2e-06 l=2e-06 nrd=0.0 nrs=0.0
.options device temp=27.0 tnom=27.0 gmin=1e-12
.OP
.PRINT DC FORMAT=RAW FILE=vamos_a1.raw V(*) I(VD1) I(VD2) I(VD3) I(VD4) I(VD5) I(VD6) I(VD7) I(VD8) I(VG)
.end
