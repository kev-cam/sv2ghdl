* // e2e 9: a BSIM4 model group binned in l and w; an edge geometry exactly on lmin; a MOS without l
* generated by vamos
.model nch.1 nmos level=54 lmin=1e-07 lmax=1e-06 wmin=1e-07 wmax=1e-06 vth0=0.4 toxe=2e-09 rdsmod=1.0 igbmod=1.0
.model nch.2 nmos level=54 lmin=1e-06 lmax=1e-05 wmin=1e-07 wmax=1e-06 vth0=0.45 toxe=2e-09 rdsmod=1.0 igbmod=1.0
.model nch.3 nmos level=54 lmin=1e-07 lmax=1e-06 wmin=1e-06 wmax=1e-05 vth0=0.5 toxe=2e-09 rdsmod=1.0 igbmod=1.0
.model nch.4 nmos level=54 lmin=1e-06 lmax=1e-05 wmin=1e-06 wmax=1e-05 vth0=0.55 toxe=2e-09 rdsmod=1.0 igbmod=1.0
.model b4ref nmos level=54 vth0=0.55 toxe=2e-09 rdsmod=1.0 igbmod=1.0
.model b1ref nmos level=54 vth0=0.4 toxe=2e-09 rdsmod=1.0 igbmod=1.0
Vg g 0 DC 1.2
