// e2e 16: prevoppoint after a tran: the AC gain at the final transient state against a fresh op
// generated by vamos
ground 0
load "resistor.osdi"
load "capacitor.osdi"
load "spice/diode.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_capacitor capacitor
V1 (in 0) vamos_vsource type="pulse" val0=0.0 val1=2.0 delay=0.0 rise=1e-09 fall=1e-09 width=1.0 mag=1.0 phase=0.0
R1 (in out) vamos_resistor r=1000.0
D1 (out 0) m_dm
C1 (out 0) vamos_capacitor c=1e-09
model m_dm sp_diode level=1.0 is=1e-14 eg=1.124481
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(in) v(out)
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a1 tran step=2e-08 stop=2e-05 maxstep=4.0000000000000003e-07 store="vamos_s1"
  options relref="alllocal"
  clear saves
  save dv(in) dv(out)
  analysis vamos_a2 ac values=[1000.0] nodeset="vamos_s1" opsolve=0
  analysis vamos_a3 ac values=[1000.0]
endc
