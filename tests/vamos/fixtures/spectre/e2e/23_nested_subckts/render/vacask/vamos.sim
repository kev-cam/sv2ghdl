// e2e 23: nested subckts, UG pp.85-86's parameter inheritance (VACASK through the lift)
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_isource isource
model vamos_resistor resistor
parameters p1=vamos_v_p1
parameters p2=2.0
I1 (0 a1) vamos_isource type="dc" dc=1.0
R1 (a1 0) vamos_resistor r=p1
I2 (0 a2) vamos_isource type="dc" dc=1.0
R2 (a2 0) vamos_resistor r=p1+p2
X1 (0) s1 p4=8.0
subckt s1 (b)
  parameters p1=4.0
  parameters p3=5.0
  parameters p4=6.0
  parameters $mfactor=1.0
  I1 (b n1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (n1 b) vamos_resistor r=p1 $mfactor=$mfactor
  I2 (b n2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (n2 b) vamos_resistor r=p2 $mfactor=$mfactor
  I3 (b n3) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R3 (n3 b) vamos_resistor r=p3 $mfactor=$mfactor
  I4 (b n4) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R4 (n4 b) vamos_resistor r=p4 $mfactor=$mfactor
  I5 (b n5) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R5 (n5 b) vamos_resistor r=p1+p2/p3 $mfactor=$mfactor
  X2 (b) s1__s2 p1=p1 p4=p4 $mfactor=$mfactor
  X3 (b) s1__s2 p3=9.0 p1=p1 p4=p4 $mfactor=$mfactor
ends
subckt s1__s2 (b)
  parameters p1=0.0
  parameters p4=0.0
  parameters p3=7.0
  parameters $mfactor=1.0
  I1 (b m1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (m1 b) vamos_resistor r=p1 $mfactor=$mfactor
  I2 (b m2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (m2 b) vamos_resistor r=p2 $mfactor=$mfactor
  I3 (b m3) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R3 (m3 b) vamos_resistor r=p3 $mfactor=$mfactor
  I4 (b m4) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R4 (m4 b) vamos_resistor r=p4 $mfactor=$mfactor
  I5 (b m5) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R5 (m5 b) vamos_resistor r=p1+p2/p3 $mfactor=$mfactor
  X4 (b) s2__s3 p1=p1 p3=p3 p4=p4 $mfactor=$mfactor
ends
subckt s2__s3 (b)
  parameters p1=0.0
  parameters p3=0.0
  parameters p4=0.0
  parameters $mfactor=1.0
  I1 (b k1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (k1 b) vamos_resistor r=p3 $mfactor=$mfactor
  I2 (b k2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (k2 b) vamos_resistor r=p1*p4 $mfactor=$mfactor
ends
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_p1=1.0
  save default
  analysis vamos_a1 op
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a2 tran step=1.5e-07 stop=0.00015 maxstep=2.9999999999999997e-06
  options relref="alllocal"
  sweep vamos_w1 variable="vamos_v_p1" values=[0.5, 1.0, 2.0, 2.0] continuation=1
    analysis vamos_a3 op
endc
