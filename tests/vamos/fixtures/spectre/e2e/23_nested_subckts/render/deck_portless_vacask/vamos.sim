// e2e 23 (also): UG pp.85-86's portless subckts (x1 s1 p4=8), nested, on VACASK
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_isource isource
model vamos_resistor resistor
parameters p1=vamos_v_p1
parameters p2=2.0
I1 (0 a1) vamos_isource type="dc" dc=1.0
R1 (a1 0) vamos_resistor r=p1
I2 (0 a2) vamos_isource type="dc" dc=1.0
R2 (a2 0) vamos_resistor r=p1+p2
X1 () s1 p4=8.0
subckt s1 ()
  parameters p1=4.0
  parameters p3=5.0
  parameters p4=6.0
  parameters $mfactor=1.0
  I1 (0 n1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (n1 0) vamos_resistor r=p1 $mfactor=$mfactor
  I2 (0 n2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (n2 0) vamos_resistor r=p2 $mfactor=$mfactor
  I3 (0 n3) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R3 (n3 0) vamos_resistor r=p3 $mfactor=$mfactor
  I4 (0 n4) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R4 (n4 0) vamos_resistor r=p4 $mfactor=$mfactor
  I5 (0 n5) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R5 (n5 0) vamos_resistor r=p1+p2/p3 $mfactor=$mfactor
  X2 () s1__s2 p1=p1 p4=p4 $mfactor=$mfactor
  X3 () s1__s2 p3=9.0 p1=p1 p4=p4 $mfactor=$mfactor
ends
subckt s1__s2 ()
  parameters p1=0.0
  parameters p4=0.0
  parameters p3=7.0
  parameters $mfactor=1.0
  I1 (0 m1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (m1 0) vamos_resistor r=p1 $mfactor=$mfactor
  I2 (0 m2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (m2 0) vamos_resistor r=p2 $mfactor=$mfactor
  I3 (0 m3) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R3 (m3 0) vamos_resistor r=p3 $mfactor=$mfactor
  I4 (0 m4) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R4 (m4 0) vamos_resistor r=p4 $mfactor=$mfactor
  I5 (0 m5) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R5 (m5 0) vamos_resistor r=p1+p2/p3 $mfactor=$mfactor
  X4 () s2__s3 p1=p1 p3=p3 p4=p4 $mfactor=$mfactor
ends
subckt s2__s3 ()
  parameters p1=0.0
  parameters p3=0.0
  parameters p4=0.0
  parameters $mfactor=1.0
  I1 (0 k1) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R1 (k1 0) vamos_resistor r=p3 $mfactor=$mfactor
  I2 (0 k2) vamos_isource type="dc" dc=1.0 $mfactor=$mfactor
  R2 (k2 0) vamos_resistor r=p1*p4 $mfactor=$mfactor
ends
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_p1=1.0
  save default
  analysis vamos_a1 op
  sweep vamos_w1 variable="vamos_v_p1" values=[0.5, 1.0, 2.0, 2.0] continuation=1
    analysis vamos_a2 op
endc
