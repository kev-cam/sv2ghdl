// e2e 21: resistors (sec. 3.8): r = 0, a card's r folded into its instances, an instance scale, isnoisy=no
// generated by vamos
ground 0
load "resistor.osdi"
load "spice/resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
V1 (in 0) vamos_vsource type="dc" dc=1.0
R0 (in a) vamos_vsource dc=0.0
Ra (a 0) vamos_resistor r=1000.0
model m_rcard sp_resistor
R1 (in b) m_rcard r=2000.0
model m_rgeo sp_resistor
R2 (b 0) m_rgeo r=653.3333333333335 w=2e-06 l=1e-05
R3 (in c) m_rgeo r=565.7142857142857 w=4e-06 l=2e-05
R4 (c 0) vamos_resistor r=1000.0
Vn (n1 0) vamos_vsource type="dc" dc=0.0
Rn (n1 nq) vamos_resistor r=1000.0
Rq (nq 0) vamos_resistor r=1000.0 noisy=0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(a) v(b) v(c) i(R0) v(nq)
  analysis vamos_a1 op
  clear saves
  save nc(Ra) nc(R1) nc(R2) nc(R3) nc(R4) nc(Rn)
  analysis vamos_a2 noise out="nq" in="Vn" from=1000.0 to=10000.0 mode="dec" points=1
endc
