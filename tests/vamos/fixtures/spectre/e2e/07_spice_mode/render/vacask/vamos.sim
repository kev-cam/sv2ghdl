// e2e 7: a SPICE-mode file with .op .ac .tran, and a Spectre file holding a SPICE model section
// generated by vamos
ground 0
load "resistor.osdi"
load "capacitor.osdi"
load "spice/diode.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_capacitor capacitor
v1 (in 0) vamos_vsource type="dc" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=1.0 mag=1.0 phase=0.0
r1 (in out) vamos_resistor r=1000.0
c1 (out 0) vamos_capacitor c=1e-06
v2 (x 0) vamos_vsource type="dc" dc=0.6
d1 (x 0) m_dm
model m_dm sp_diode level=1.0 is=1e-14 n=1.5 nbv=1.0 eg=1.124481
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default
  analysis vamos_a1 op
  analysis vamos_a2 ac from=1.0 to=1000000.0 mode="dec" points=10
  alter instance("v1") type="sine" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=1.0 mag=1.0 phase=0.0
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a3 tran step=1e-06 stop=0.001 maxstep=2e-05
  options relref="alllocal"
  alter instance("v1") type="dc" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=1.0 mag=1.0 phase=0.0
endc
