// e2e 6: alter dev=Vdif param=type between an op and a tran, then back to dc (the UG op-amp pattern)
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
Vdif (a 0) vamos_vsource type="dc" dc=0.0
R1 (a 0) vamos_resistor r=1000.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(a) i(Vdif)
  analysis vamos_a1 op
  alter instance("Vdif") type="dc" val0=0.0 val1=2.0 delay=1e-08 rise=2e-15 fall=2e-15 width=1e-06 dc=0.0
  alter instance("Vdif") type="pulse" val0=0.0 val1=2.0 delay=1e-08 rise=2e-15 fall=2e-15 width=1e-06 dc=0.0
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a2 tran step=1.9999999999999997e-09 stop=2e-06 maxstep=4e-08
  options relref="alllocal"
  alter instance("Vdif") type="dc" val0=0.0 val1=2.0 delay=1e-08 rise=2e-15 fall=2e-15 width=1e-06 dc=0.0
  alter instance("Vdif") type="dc" dc=0.0
  analysis vamos_a3 op
endc
