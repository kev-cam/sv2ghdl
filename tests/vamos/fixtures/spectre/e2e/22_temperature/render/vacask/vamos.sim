// e2e 22: temperature (sec. 3.10, sec. 3.9): an options-free netlist at 27 C, a diode card without eg at 127 C,
// generated by vamos
ground 0
load "resistor.osdi"
load "spice/diode.osdi"
load "spice/mos3.osdi"
model vamos_resistor resistor
model vamos_isource isource
model vamos_vsource vsource
Rn (n1 0) vamos_resistor r=1000.0
I1 (0 d) vamos_isource type="dc" dc=0.001
D1 (d 0) m_dnoeg
model m_dnoeg sp_diode level=1.0 is=1e-14 eg=1.124481
model m_fast_1x1 sp_mos3 type=1.0 vto=(($temp>=27.0 ? 0.9 : 0.75)) phi=0.7 gamma=0.0 nsub=1.13e+16 mjsw=0.3333333333333333 badmos3=1.0
model m_m075 sp_mos3 type=1.0 vto=0.75 phi=0.7 gamma=0.0 nsub=1.13e+16 mjsw=0.3333333333333333 badmos3=1.0
model m_m090 sp_mos3 type=1.0 vto=0.9 phi=0.7 gamma=0.0 nsub=1.13e+16 mjsw=0.3333333333333333 badmos3=1.0
Vg (g 0) vamos_vsource type="dc" dc=2.0
Vd1 (d1 0) vamos_vsource type="dc" dc=3.0
Vd2 (d2 0) vamos_vsource type="dc" dc=3.0
Vd3 (d3 0) vamos_vsource type="dc" dc=3.0
M1 (d1 g 0 0) m_fast_1x1 w=1e-05 l=2e-06 nrd=0.0 nrs=0.0
M2 (d2 g 0 0) m_m075 w=1e-05 l=2e-06 nrd=0.0 nrs=0.0
M3 (d3 g 0 0) m_m090 w=1e-05 l=2e-06 nrd=0.0 nrs=0.0
vamos_nin1 (n1 0) vamos_isource type="dc" dc=0.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save nc(Rn) nc(D1) nc(M1) nc(M2) nc(M3)
  analysis vamos_a1 noise out="n1" in="vamos_nin1" from=1000.0 to=10000.0 mode="dec" points=1
  clear saves
  save v(d) i(Vd1) i(Vd2) i(Vd3)
  analysis vamos_a2 op
  sweep vamos_w2 option="temp" values=[25.0, 50.0] continuation=1
    analysis vamos_a3 op
  options temp=127.0
  analysis vamos_a4 op
endc
