// e2e 5: xf of a divider: the transfer function of V1, no trace for an iprobe or a short
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
V1 (in 0) vamos_vsource type="dc" dc=0.0 mag=1.0 phase=0.0
R1 (in mid) vamos_resistor r=1000.0
Ip (mid out) vamos_vsource type="dc" dc=0.0
Rs (out o2) vamos_vsource dc=0.0
R2 (o2 0) vamos_resistor r=1000.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  analysis vamos_a1 acxf out="out" from=1000.0 to=10000.0 mode="dec" points=1
endc
