// e2e 4: noise of a 1k/1k divider, with and without an input probe, a resistor inside a subckt
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_isource isource
V1 (in 0) vamos_vsource type="dc" dc=0.0
R1 (in out) vamos_resistor r=1000.0
R2 (out 0) vamos_resistor r=1000.0
I2 (out) cell
subckt cell (a)
  parameters $mfactor=1.0
  r3 (a 0) vamos_resistor r=1000000000.0 $mfactor=$mfactor
ends
vamos_nin2 (out 0) vamos_isource type="dc" dc=0.0
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save nc(R1) nc(R2) nc('I2:r3')
  analysis vamos_a1 noise out="out" in="V1" from=1000.0 to=10000.0 mode="dec" points=1
  analysis vamos_a2 noise out="out" in="vamos_nin2" from=1000.0 to=10000.0 mode="dec" points=1
endc
