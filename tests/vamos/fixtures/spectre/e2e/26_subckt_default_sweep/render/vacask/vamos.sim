// e2e 26: a subckt default that reads a swept parameter follows the sweep (E53's pattern)
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
parameters rval=vamos_v_rval
parameters rdep=rval*2.0
V1 (in 0) vamos_vsource type="dc" dc=1.0
X1 (in o1) rsec
X2 (in o2) rsec2
X3 (in o3) rsec r=3000.0
subckt rsec (a b)
  parameters r=-1.2345678901234568e-300
  parameters r__v=((r==(-1.2345678901234568e-300) ? rdep : r))
  parameters $mfactor=1.0
  R1 (a b) vamos_resistor r=r__v $mfactor=$mfactor
  R2 (b 0) vamos_resistor r=1000.0 $mfactor=$mfactor
ends
subckt rsec2 (a b)
  parameters r=rval*3.0
  parameters $mfactor=1.0
  R1 (a b) vamos_resistor r=r $mfactor=$mfactor
  R2 (b 0) vamos_resistor r=1000.0 $mfactor=$mfactor
ends
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_rval=1000.0
  save default
  analysis vamos_a1 op
  sweep vamos_w1 variable="vamos_v_rval" values=[1000.0, 2000.0] continuation=0
    analysis vamos_a2 op
  analysis vamos_a3 op
endc
