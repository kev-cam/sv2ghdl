// e2e 24: a diode's sidewall capacitance with fc=0.3 and no fcs: Spectre's fcs=fc (ref5 p.305), not 0.5
// generated by vamos
ground 0
load "spice/diode.osdi"
model vamos_vsource vsource
V1 (a 0) vamos_vsource type="dc" dc=0.0 mag=1.0 phase=0.0
D1 (a 0) m_dsw pj=2.0
model m_dsw sp_diode level=1.0 is=1e-18 cjo=0.0 cjsw=1e-12 vjsw=0.8 mjsw=0.5 fc=0.3 fcs=0.3 eg=1.124481
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default
  sweep vamos_w1 instance="V1" parameter="dc" values=[-1.0, 0.0, 0.2, 0.24, 0.3, 0.4, 0.5, 0.6] continuation=0
    analysis vamos_a1 ac values=[1000000.0]
endc
