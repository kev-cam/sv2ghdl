// e2e 3: a sweep block with dc and ac children, repeated values and a nested sweep
// generated by vamos
ground 0
load "resistor.osdi"
load "capacitor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_capacitor capacitor
parameters rval=vamos_v_rval
parameters cval=vamos_v_cval
V1 (in 0) vamos_vsource type="dc" dc=1.0 mag=1.0 phase=0.0
R1 (in out) vamos_resistor r=rval
C1 (out 0) vamos_capacitor c=cval
control
  abort except analysis
  options rawfile="binary" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_rval=1000.0 vamos_v_cval=1e-06
  save v(out) i(V1)
  sweep vamos_w1 variable="vamos_v_rval" values=[1000.0, 1000.0, 2000.0] continuation=0
    analysis vamos_a1 op
  clear saves
  save dv(out) di(V1)
  sweep vamos_w2 variable="vamos_v_rval" values=[1000.0, 1000.0, 2000.0] continuation=0
    analysis vamos_a2 ac from=1.0 to=1000.0 mode="dec" points=1
  clear saves
  save v(out) i(V1)
  sweep vamos_w4 variable="vamos_v_rval" values=[1000.0, 1000.0, 2000.0] continuation=0
    sweep vamos_w5 variable="vamos_v_cval" values=[1e-06, 2e-06] continuation=0
      analysis vamos_a3 op
  clear saves
  save dv(out) di(V1)
  sweep vamos_w6 variable="vamos_v_rval" values=[1000.0, 1000.0, 2000.0] continuation=0
    sweep vamos_w7 variable="vamos_v_cval" values=[1e-06, 2e-06] continuation=0
      analysis vamos_a4 ac from=10.0 to=100.0 mode="dec" points=1
endc
