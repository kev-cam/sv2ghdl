nested definition inherits rr
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_resistor resistor
model vamos_vsource vsource
subckt s1 (a b)
  parameters rr=1000.0
  parameters $mfactor=1.0
  xs (a mid) s1__s2 rr=rr $mfactor=$mfactor
  r2 (mid b) vamos_resistor r=1000.0 $mfactor=$mfactor
ends
v1 (in 0) vamos_vsource type="dc" dc=1.0
x1 (in out) s1 rr=2000.0
rl (out 0) vamos_resistor r=1000.0
subckt s1__s2 (x y)
  parameters rr=0.0
  parameters $mfactor=1.0
  r1 (x y) vamos_resistor r=rr $mfactor=$mfactor
ends
control
  abort always
  options tran_lteimplicit=0 temp=27.0 tnom=27.0
  analysis vamos_tran tran step=1e-09 stop=1e-08
endc
