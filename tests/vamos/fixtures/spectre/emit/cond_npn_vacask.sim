UG p.110 npn_mod binning by area
// generated by vamos
ground 0
load "spice/bjt.osdi"
model vamos_vsource vsource
vin (1 0) vamos_vsource dc=1.0
vb (2 0) vamos_vsource dc=0.7
vb3 (3 0) vamos_vsource dc=0.65
subckt npn_mod (c b e s)
  parameters area=5e-12
  parameters $mfactor=1.0
  @if real(area<1e-10)
    npn_mod (c b e s) m_npn10x10 $mfactor=$mfactor
  @else
    @if real(area<4e-10)
      npn_mod (c b e s) m_npn20x20 $mfactor=$mfactor
    @else
      npn_mod (c b e s) m_npn_default $mfactor=$mfactor
    @end
  @end
  model m_npn_default sp_bjt type=1.0 is=3.2e-16 vaf=59.8
  model m_npn10x10 sp_bjt type=1.0 is=3.5e-16 vaf=61.5
  model m_npn20x20 sp_bjt type=1.0 is=3.77e-16 vaf=60.5
ends
q1 (1 2 0 0) npn_mod area=3.5e-10
q2 (1 3 0 0) npn_mod area=2.5e-11
q3 (1 3 0 0) npn_mod area=1e-09
control
  abort always
  options tran_lteimplicit=0 temp=25.0 tnom=25.0
  save v(1) i(vin)
  analysis vamos_tran tran step=1e-09 stop=1e-08
endc
