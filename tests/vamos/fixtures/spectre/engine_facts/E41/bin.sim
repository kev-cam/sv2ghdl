binned device: sweep of the instance width across a bin edge
ground 0
load "spice/mos1.osdi"
model vamos_vsource vsource
model m_nch_1 sp_mos1 type=1 vto=0.5 kp=1e-4
model m_nch_2 sp_mos1 type=1 vto=1.0 kp=1e-4
vd (d 0) vamos_vsource dc=2
vg (g 0) vamos_vsource dc=2
@if (5e-6 >= 0 && 5e-6 < 10e-6)
  m1 (d g 0 0) m_nch_1 w=5e-6 l=1e-6
@elseif (5e-6 >= 10e-6 && 5e-6 < 1)
  m1 (d g 0 0) m_nch_2 w=5e-6 l=1e-6
@end
control
  options rawfile="ascii"
  save i(vd)
  sweep sw instance="m1" parameter="w" values=[5e-6, 20e-6]
  analysis op1 op
endc
