mos1 card A
load "spice/mos1.osdi"
model vs vsource
model nch sp_mos1 type=1 vto=0.7 kp=1e-4 tox=1e-7 phi=0.7 lambda=0.02  
vd (d 0) vs dc=3
vg (g 0) vs dc=2
m1 (d g 0 0) nch w=10u l=2u
control
  options rawfile="ascii"
  sweep s instance="vd" parameter="dc" values=[1.5, 3, 5]
    analysis op1A op
endc
