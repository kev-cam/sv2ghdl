mos default length: instance gives only w
ground 0
load "spice/mos1.osdi"
model vamos_vsource vsource
model m_nch sp_mos1 type=1 vto=0.7 kp=1e-4
vd (d 0) vamos_vsource dc=2
vg (g 0) vamos_vsource dc=2
@if which == 1
m1 (d g 0 0) m_nch w=30e-6
@else
m1 (d g 0 0) m_nch w=30e-6 l=3e-6
@end
control
  options rawfile="ascii"
  save i(vd)
  var which=1
  analysis op1 op
  var which=2
  analysis op2 op
endc
