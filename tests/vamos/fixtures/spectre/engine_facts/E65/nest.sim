nested subckt inheritance
load "resistor.osdi"
model resistor resistor
model vsource vsource
subckt outer (a b)
  parameters rr=3k
  subckt inner (x y)
    r1 (x y) resistor r=rr
  ends
  xi (a b) inner
ends
v1 (in 0) vsource dc=1
x1 (in out) outer rr=1k
r2 (out 0) resistor r=1k
control
  options rawfile="ascii"
  analysis op1 op
endc
