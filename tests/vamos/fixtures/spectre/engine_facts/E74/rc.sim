RC Low-Pass Filter
// generated by vamos
ground 0
load "resistor.osdi"
load "capacitor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
model vamos_capacitor capacitor
parameters rval=vamos_v_rval
v1 (in 0) vamos_vsource type="pulse" val0=0 val1=1 delay=1m rise=1u fall=1u width=4m period=10m dc=0 mag=1 phase=0
x1 (in out) rcsec r=rval
subckt rcsec (a b)
  parameters r=1000
  parameters $mfactor=1.0
  r1 (a b) vamos_resistor r=r
  c1 (b 0) vamos_capacitor c=1e-6
ends
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  var vamos_v_rval=1000.0
  save default
  analysis vamos_a1 op
  analysis vamos_a2 ac from=1.0 to=1000000.0 mode="dec" points=10
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  sweep vamos_w1 variable="vamos_v_rval" values=[1000.0, 2000.0]
    analysis vamos_a3 tran step=5e-06 stop=0.005 maxstep=0.0001
  options relref="alllocal"
endc
