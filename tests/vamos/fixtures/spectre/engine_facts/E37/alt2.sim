alter type dc to pulse, inactive pulse params emitted, no rise/fall
load "resistor.osdi"
model resistor resistor
model vsource vsource
v1 (in 0) vsource type="dc" dc=0 val0=0 val1=2 width=1u delay=10n
r1 (in 0) resistor r=1k
control
  options rawfile="ascii"
  analysis op1 op
  alter instance("v1") type="pulse"
  analysis tr2 tran stop=3u step=1n maxstep=10n
endc
