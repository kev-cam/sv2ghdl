the same diode without ik, as vamos renders it for VACASK
// generated by vamos
ground 0
load "resistor.osdi"
load "spice/diode.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
Vd (d 0) vamos_vsource type="dc" dc=1.0
Rd (d da) vamos_resistor r=100.0
D1 (da 0) m_dm
model m_dm sp_diode level=1.0 is=1e-14 n=1.0 nbv=1.0 eg=1.124481
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(da) i(Vd)
  analysis noik op
endc
