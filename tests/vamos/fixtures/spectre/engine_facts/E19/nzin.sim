noise without input
ground 0
load "resistor.osdi"
model vs vsource
model is isource
model r resistor
v1 (in 0) vs dc=1
r1 (in out) r r=1k
r2 (out 0) r r=1k
vamos_nin (out 0) is dc=0
control
  options rawfile="ascii"
  analysis nz2 noise out="out" from=1k to=10k mode="dec" points=1
  analysis nz6 noise out="out" in="vamos_nin" from=1k to=10k mode="dec" points=1
  analysis nz7 noise out="out" in="v1" from=1k to=10k mode="dec" points=1
endc
