the tran ic forcing (e2e 25 flattened): Mid starts at the ic 0.3, then relaxes to 0.75 with tau = 750 ns
ground 0
load "resistor.osdi"
load "capacitor.osdi"
model vamos_resistor resistor
model vamos_capacitor capacitor
model vamos_vsource vsource
V0 (net1 0) vamos_vsource type="dc" dc=1.0
r3 (net1 Mid) vamos_resistor r=1000.0
r4 (Mid out) vamos_resistor r=1000.0
C0 (Mid 0) vamos_capacitor c=1e-09
R0 (out 0) vamos_resistor r=2000.0
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 tran_lteimplicit=0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save v(Mid) v(out)
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis tric tran step=5e-09 stop=5e-06 maxstep=1e-07 ic={"Mid", 0.3}
endc
