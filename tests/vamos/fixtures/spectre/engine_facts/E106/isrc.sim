XDM INDEPENDENT_SOURCES i_sources as vamos renders it for VACASK (I44: an exp source, td2 at 600 us)
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_isource isource
model vamos_resistor resistor
I33 (net010 0) vamos_isource type="dc" dc=1.0
I22 (net06 0) vamos_isource type="dc" dc=5.0
I11 (net8 0) vamos_isource type="sine" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0
I55 (net6 0) vamos_isource type="sine" sinedc=1.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0
I77 (net7 0) vamos_isource type="sine" sinedc=1.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 mag=0.5 phase=0.0
I66 (net12 0) vamos_isource type="pulse" val0=1.0 val1=10.0 delay=5e-05 rise=5e-05 fall=7e-05 width=0.0002 period=0.0004
I44 (net08 0) vamos_isource type="exp" val0=0.0 val1=1.0 delay=0.0001 tau1=2e-05 td2=0.0004999999999999999 tau2=4e-05
R4 (net08 0) vamos_resistor r=1000.0
R3 (net010 0) vamos_resistor r=1000.0
R2 (net06 0) vamos_resistor r=1000.0
R1 (net8 0) vamos_resistor r=1000.0
R5 (net6 0) vamos_resistor r=1000.0
R6 (net12 0) vamos_resistor r=1000.0
R7 (net7 0) vamos_resistor r=1000.0
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default p(R1, i) p(R2, i) p(R3, i) p(R4, i) p(R5, i) p(R6, i) p(R7, i)
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a1 tran step=1e-06 stop=0.001 maxstep=2e-05
  options relref="alllocal"
endc
