R10 (0 V10) vamos_resistor r=2000.0
R12 (V12 0) vamos_resistor r=1000.0
R11 (net11 V12) vamos_resistor r=1000.0
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  alter instance("V1") type="sine" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=0.0 mag=0.0 phase=0.0
  save default
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a1 tran step=1e-06 stop=0.001 maxstep=2e-05
  options relref="alllocal"
  alter instance("V1") type="dc" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=0.0 mag=0.0 phase=0.0
