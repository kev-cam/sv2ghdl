V3 (net5 0) vamos_vsource type="dc" dc=5.0
V7 (net1 0) vamos_vsource type="exp" val0=0.0 val1=1.0 delay=0.0001 tau1=2e-05 td2=0.0004999999999999999 tau2=4e-05
V1 (net7 0) vamos_vsource type="dc" sinedc=0.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0 dc=0.0 mag=0.0 phase=0.0
V9 (net9 0) vamos_vsource type="sine" sinedc=1.0 ampl=1.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0
V11 (net11 0) vamos_vsource type="pulse" val0=1.0 val1=10.0 delay=5e-05 rise=5e-05 fall=7e-05 width=0.0002 period=0.0004
R7 (net1 V8) vamos_resistor r=1000.0
R8 (0 V8) vamos_resistor r=2000.0
R6 (0 V6) vamos_resistor r=2000.0
R5 (net3 V6) vamos_resistor r=1000.0
R4 (0 V4) vamos_resistor r=2000.0
R3 (net5 V4) vamos_resistor r=1000.0
R1 (net7 V2) vamos_resistor r=1000.0
