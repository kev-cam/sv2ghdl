XDM INDEPENDENT_SOURCES v_sources as vamos renders it for VACASK (V7: an exp source, td2 at 600 us)
// generated by vamos
ground 0
load "resistor.osdi"
model vamos_vsource vsource
model vamos_resistor resistor
