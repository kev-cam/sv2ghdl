cpow print rule on VACASK: (y==0 ? 1 : pow(x,y)), precedence, $tnom, hypot, fmod
ground 0
load "resistor.osdi"
model vsrc vsource
model res resistor
parameters x0=0 y0=0 y2=2 xm2=-2 y3=3 x2=2 y15=1.5
v1 (n1 0) vsrc dc=(y0==0 ? 1 : pow(x0,y0))
r1 (n1 0) res r=1k
v2 (n2 0) vsrc dc=(y2==0 ? 1 : pow(x0,y2))
r2 (n2 0) res r=1k
v3 (n3 0) vsrc dc=(y3==0 ? 1 : pow(xm2,y3))
r3 (n3 0) res r=1k
v4 (n4 0) vsrc dc=(y15==0 ? 1 : pow(x2,y15))
r4 (n4 0) res r=1k
v5 (n5 0) vsrc dc=-2**2
r5 (n5 0) res r=1k
v6 (n6 0) vsrc dc=-x2**y2
r6 (n6 0) res r=1k
v7 (n7 0) vsrc dc=$tnom
r7 (n7 0) res r=1k
v8 (n8 0) vsrc dc=$temp
r8 (n8 0) res r=1k
v9 (n9 0) vsrc dc=hypot(3, 4)
r9 (n9 0) res r=1k
v10 (n10 0) vsrc dc=fmod(-7, 3)
r10 (n10 0) res r=1k
v11 (n11 0) vsrc dc=M_DEGPERRAD
r11 (n11 0) res r=1k
v12 (n12 0) vsrc dc=2**3**2
r12 (n12 0) res r=1k
control
  options rawfile="ascii" temp=50 tnom=27
  analysis op1 op
endc
