XDM DIODE_CLIPPER diodeClipper as vamos renders it for VACASK (tran_lteimplicit=0, maxstep T/50 = 40 us)
// generated by vamos
ground 0
load "spice/diode.osdi"
load "capacitor.osdi"
load "resistor.osdi"
model vamos_capacitor capacitor
model vamos_resistor resistor
model vamos_vsource vsource
model m_diodea sp_diode level=1.0 is=4e-10 rs=0.105 n=1.48 tt=8e-07 cjo=1.95e-11 vj=0.4 m=0.38 eg=1.36 xti=-8.0 kf=0.0 af=1.0 fc=0.9 bv=600.0 ibv=0.0001 fcs=0.9 nbv=1.0
model m_diodep sp_diode level=1.0 is=4e-10 rs=0.105 n=1.48 tt=8e-07 cjo=1.95e-11 vj=0.4 m=0.38 eg=1.36 xti=-8.0 kf=0.0 af=1.0 fc=0.9 bv=600.0 ibv=0.0001 fcs=0.9 nbv=1.0
D2 (0 N03179) m_diodea
D1 (N03179 N04104) m_diodep
C1 (N03179 N03334) vamos_capacitor c=4.7e-07
R4 (N03334 0) vamos_resistor r=5600.0
R3 (N03179 0) vamos_resistor r=3300.0
R2 (N04104 N03179) vamos_resistor r=3300.0
R1 (N03179 N04173) vamos_resistor r=1000.0
V2 (N04173 0) vamos_vsource type="sine" sinedc=0.0 ampl=10.0 freq=1000.0 delay=0.0 theta=0.0 tdphase=0.0
V1 (N04104 0) vamos_vsource type="dc" dc=5.0
control
  abort except analysis
  options rawfile="ascii" strictoutput=0 strictsave=2 tran_lteimplicit=0 temp=27.0 tnom=27.0 reltol=0.001 vntol=1e-06 abstol=1e-12 gmin=1e-12
  save default
  options relref="sigglobal" tran_method="trap" tran_lteratio=3.5
  analysis vamos_a1 tran step=2e-06 stop=0.002 maxstep=4e-05
  options relref="alllocal"
endc
