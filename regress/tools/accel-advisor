def which_yosys():
    for c in (os.environ.get("YOSYS"), shutil.which("yosys"),
              "/usr/local/src/yosys-build/yosys"):
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def run(cmd, timeout, env=None):
    try:
        return subprocess.run(["/usr/bin/timeout", "-k", "5", str(timeout)]
                              + cmd, capture_output=True, text=True, env=env)
    except FileNotFoundError:
        # no /usr/bin/timeout: refuse unbounded synthesis
        print("FATAL: /usr/bin/timeout not found — refusing unbounded runs",
              file=sys.stderr)
        sys.exit(3)


class Report:
    def __init__(self):
        self.env_audit = []
        self.modules = defaultdict(lambda: {"classes": [], "risks": [],
                                            "verdict": None})
        self.blocker_counts = defaultdict(int)
        self.chunk_inventory = {"active": 0, "verify": 0, "declined": 0}
        self.notes = []

    def add(self, module, cid, evidence):
        sev = CATALOG[cid][0]
        entry = {"id": cid, "severity": sev, "evidence": evidence,
                 "advice": CATALOG[cid][3]}
        m = self.modules[module]
        if sev == "risk":
            if cid not in [r["id"] for r in m["risks"]]:
                m["risks"].append(entry)
        else:
            if (cid, evidence) not in [(c["id"], c["evidence"])
                                       for c in m["classes"]]:
                m["classes"].append(entry)
        if sev == "blocks":
            self.blocker_counts[cid] += 1

    def finalize(self):
        worst = 0
        for name, m in self.modules.items():
            blocks = [c for c in m["classes"] if c["severity"] == "blocks"]
            degrades = [c for c in m["classes"] if c["severity"] == "degrades"]
            if blocks:
                m["verdict"] = "BLOCKED:%s" % blocks[0]["id"]
                worst = max(worst, 1)
            elif degrades:
                m["verdict"] = "DEGRADED:%s" % ",".join(c["id"]
                                                       for c in degrades)
            else:
                m["verdict"] = "ACCELERABLE"
            if m["risks"]:
                # a RISK denies known-correct until the stage-4 probe passes
                if m["verdict"] == "ACCELERABLE":
                    worst = max(worst, 2)
        return worst

    def print_text(self):
        print("=" * 72)
        print("accel-advisor report")
        print("=" * 72)
        for line in self.env_audit:
            print("  env:", line)
        inv = self.chunk_inventory
        if any(inv.values()):
            print("  chunks: %d ACTIVE, %d VERIFY, %d declined"
                  % (inv["active"], inv["verify"], inv["declined"]))
        if self.blocker_counts:
            print("  blocker ranking:")
            for cid, n in sorted(self.blocker_counts.items(),
                                 key=lambda kv: -kv[1]):
                print("    %4d  %s  %s" % (n, cid, CATALOG[cid][1]))
        print("-" * 72)
        for name in sorted(self.modules):
            m = self.modules[name]
            verdict = m["verdict"] or "UNKNOWN"
            if verdict == "ACCELERABLE" and not m["risks"]:
                verdict = "ACCELERABLE (known-correct candidate)"
            risky = ",".join("RISK:%s" % r["id"] for r in m["risks"])
            print("%-40s %s %s" % (name, verdict, risky))
            for c in m["classes"] + m["risks"]:
                print("    [%s] %s" % (c["id"], CATALOG[c["id"]][1]))
                print("        evidence: %s" % c["evidence"])
                print("        advice:   %s" % c["advice"])
        for n in self.notes:
            print("  note:", n)

    def to_json(self):
        return {
            "env": self.env_audit,
            "chunks": self.chunk_inventory,
            "blocker_ranking": [{"class": k, "count": v} for k, v
                                in sorted(self.blocker_counts.items(),
                                          key=lambda kv: -kv[1])],
            "modules": [{"name": k, **v} for k, v in
                        sorted(self.modules.items())],
        }


# ---------------------------------------------------------------- stage 0 --
def stage0(rep, args):
    for k, v in sorted(os.environ.items()):
        if k.startswith(("NVC_ACCEL", "GSM_", "NVC_LEVELIZE")):
            flag = ""
            if k == "NVC_ACCEL_ONLY":
                flag = "  << SILENT declines: first suspect for missing chunks"
            elif k in ("NVC_ACCEL_SKIP", "NVC_ACCEL_SKIP_SCOPE"):
                flag = "  << skips leave notes; check them"
            rep.env_audit.append("%s=%s%s" % (k, v, flag))
    if not os.path.isfile("/usr/bin/timeout"):
        rep.notes.append("NO /usr/bin/timeout — synthesis would be UNBOUNDED")
    cache = os.environ.get("NVC_ACCEL_CACHE_DIR",
                           os.path.expanduser("~/.cache/nvc/accel"))
    if os.path.isdir(cache) and not os.access(cache, os.W_OK):
        rep.notes.append("accel cache dir not writable: %s" % cache)
    if args.src and any(s.endswith((".vhd", ".vhdl")) for s in args.src):
        if os.environ.get("NVC_ACCEL_FROM_VHDL") != "1":
            rep.notes.append("VHDL input: NVC_ACCEL_FROM_VHDL=1 is MANDATORY "
                             "for the accel path (stage 3 sets it)")


# ---------------------------------------------------------------- stage 1 --
RE_GENFOR   = re.compile(r"\bfor\b.*\bgenerate\b", re.I)
RE_COMPONENT= re.compile(r"^\s*component\s+\w+", re.I | re.M)
RE_ASSERT   = re.compile(r"^\s*(assert\b|report\b)", re.I | re.M)
RE_RSTPORT  = re.compile(r"^\s*rst\s*:\s*in\b", re.I | re.M)
RE_PORTEXPR = re.compile(r"port\s+map\s*\([^;]*(\bxor\b|\band\b|\bor\b|\bnot\b"
                         r"|[+\-*/&])", re.I | re.S)
RE_ENTITY   = re.compile(r"^\s*entity\s+(\w+)\s+is", re.I | re.M)
RE_ARRAYMEM = re.compile(r"array\s*\(\s*0?\s*to\s*(\d+)|array\s*\(\s*(\d+)\s*"
                         r"downto", re.I)
RE_EDGE     = re.compile(r"rising_edge|falling_edge|'event", re.I)
RE_CASE     = re.compile(r"^\s*case\b", re.I | re.M)

def stage1(rep, args):
    for path in args.src or []:
        try:
            text = open(path, errors="replace").read()
        except OSError as e:
            rep.notes.append("cannot read %s: %s" % (path, e))
            continue
        ents = RE_ENTITY.findall(text) or [os.path.basename(path)]
        mod = ents[0]
        if RE_GENFOR.search(text):
            rep.add(mod, "B2", "for..generate in %s" % path)
        if RE_COMPONENT.search(text):
            rep.add(mod, "B2", "component instantiation in %s" % path)
        if RE_ASSERT.search(text):
            rep.add(mod, "B2", "assert/report inside DUT source %s" % path)
        if RE_RSTPORT.search(text):
            rep.add(mod, "C2", "port literally named rst in %s" % path)
        if RE_PORTEXPR.search(text):
            rep.add(mod, "C7", "expression as port-map actual in %s" % path)
        # crude flattened-memory estimate
        for m in RE_ARRAYMEM.finditer(text):
            depth = int(m.group(1) or m.group(2) or 0) + 1
            if depth >= 1024:
                rep.add(mod, "B6", "array depth %d in %s (pre-gates stage 2 "
                        "if bits exceed --mem-bit-limit)" % (depth, path))
                break
        if RE_CASE.search(text) and RE_EDGE.search(text):
            # informational pointer to the measured C12 class
            rep.add(mod, "C12", "case dispatch present in %s — confirm every "
                    "selector is reset-driven certain" % path)


# ---------------------------------------------------------------- stage 2 --
YOSYS_SCRIPT = """read_verilog {src}
hierarchy -auto-top
proc; flatten; opt -keepdc; dffunmap; opt_clean
stat
scc
"""

def stage2(rep, args, yosys):
    if not yosys:
        rep.notes.append("yosys not found (set YOSYS) — stage 2 skipped")
        return
    for src in args.verilog or []:
        mod = os.path.basename(src).rsplit(".", 1)[0]
        rep.modules[mod]  # register even when clean -> ACCELERABLE row
        with tempfile.NamedTemporaryFile("w", suffix=".ys",
                                         delete=False) as f:
            f.write(YOSYS_SCRIPT.format(src=src))
            ys = f.name
        r = run([yosys, "-s", ys], timeout=120)
        os.unlink(ys)
        out = r.stdout + r.stderr
        if r.returncode in (124, 137):
            rep.add(mod, "B6", "yosys diagnostic pass exceeded 120 s")
            continue
        for line in out.splitlines():
            if line.startswith("ERROR:"):
                rep.add(mod, "B10", line.strip())
            if "Latch inferred" in line:
                rep.add(mod, "B4", line.strip())
        # cell histogram
        cells = defaultdict(int)
        for m in re.finditer(r"^\s+(\d+)\s+\$(\w+)\s*$", out, re.M):
            cells[m.group(2)] += int(m.group(1))
        for c in cells:
            if c in BAD_STORAGE:
                rep.add(mod, "B4", "$%s x%d in netlist" % (c, cells[c]))
            elif c not in NARROW_OK:
                rep.add(mod, "B5", "$%s x%d outside whitelist" % (c, cells[c]))
        if not any(c in REG_CELLS for c in cells) and cells:
            rep.add(mod, "B9", "zero register cells — comb-only netlist")
        # SCCs: yosys prints "Found N SCCs"
        m = re.search(r"Found (\d+) SCCs", out)
        if m and int(m.group(1)) > 0:
            rep.add(mod, "C1", "%s combinational SCC(s) — loop nets in yosys "
                    "scc output" % m.group(1))


# ---------------------------------------------------------------- stage 3 --
def stage3(rep, args):
    env = dict(os.environ)
    env.update({"NVC_ACCEL": "1", "NVC_ACCEL_JIT": "1",
                "NVC_ACCEL_JIT_DEBUG": "1", "NVC_ACCEL_MIN_MODULES": "1",
                "NVC_ACCEL_SYNTH_TIMEOUT": "600"})
    if args.src and any(s.endswith((".vhd", ".vhdl")) for s in args.src):
        env["NVC_ACCEL_FROM_VHDL"] = "1"
    cmd = [args.nvc, "--std=2008"]
    if args.lib:
        cmd += ["-L", args.lib]
    if args.work:
        cmd += ["--work=" + args.work]
    cmd += ["-r", args.top, "--stop-time=" + args.stop_time]
    r = run(cmd, timeout=args.run_timeout, env=env)
    out = r.stdout + r.stderr
    chunk_re = re.compile(r"accel-jit:.*?'([^']+)'")
    for line in out.splitlines():
        if "accel-jit" not in line and "accel-verify" not in line:
            continue
        m = chunk_re.search(line)
        mod = m.group(1) if m else "(run)"
        # match ahead of the em-dash: its UTF-8 bytes are mangled when the
        # subprocess pipe decodes under a C locale
        if re.search(r"accel-jit: VERIFY\b", line):
            rep.chunk_inventory["verify"] += 1
            rep.add(mod, "S1", line.strip())
        elif re.search(r"accel-jit: (MERGE )?ACTIVE\b", line):
            rep.chunk_inventory["active"] += 1
        else:
            matched = False
            for cid, (_, _, regexes, _) in CATALOG.items():
                for rx in regexes:
                    if re.search(rx, line):
                        rep.add(mod, cid, line.strip())
                        matched = True
                        break
                if matched:
                    break
            if not matched and ("declin" in line or "leaving in nvc" in line):
                rep.chunk_inventory["declined"] += 1
                rep.add(mod, "B10", "unclassified decline: " + line.strip())
            elif matched and ("declin" in line or "leaving" in line):
                rep.chunk_inventory["declined"] += 1
    if rep.chunk_inventory["active"] == 0 \
            and rep.chunk_inventory["declined"] == 0:
        if os.environ.get("NVC_ACCEL_ONLY"):
            rep.add("(run)", "D8", "no chunks installed and no declines — "
                    "NVC_ACCEL_ONLY is exported (silent declines)")


# ---------------------------------------------------------------- stage 4 --
def stage4(rep, args):
    env = dict(os.environ)
    env.update({"NVC_ACCEL": "1", "NVC_ACCEL_JIT": "1",
                "NVC_ACCEL_VERIFY": "1", "NVC_ACCEL_MIN_MODULES": "1"})
    if args.src and any(s.endswith((".vhd", ".vhdl")) for s in args.src):
        env["NVC_ACCEL_FROM_VHDL"] = "1"
    cmd = [args.nvc, "--std=2008"]
    if args.lib:
        cmd += ["-L", args.lib]
    if args.work:
        cmd += ["--work=" + args.work]
    cmd += ["-r", args.top, "--stop-time=" + args.stop_time]
    r = run(cmd, timeout=args.run_timeout, env=env)
    out = r.stdout + r.stderr
    for line in out.splitlines():
        if "accel-verify" in line and \
                ("diverge" in line or re.search(r"interp=0x\S+ +accel=0x", line)):
            rep.add("(verify)", "C3", "VERIFY divergence: " + line.strip())
        if "not driven-certain" in line or "X/Z at accel boundary" in line:
            rep.add("(verify)", "C3", line.strip())


# ------------------------------------------------------------------- main --
def main():
    ap = argparse.ArgumentParser(prog="accel-advisor",
                                 description=__doc__.splitlines()[0])
    ap.add_argument("--src", nargs="*", help="VHDL sources for static scan")
    ap.add_argument("--verilog", nargs="*",
                    help="emitted/original Verilog for yosys diagnostics")
    ap.add_argument("--work", help="nvc work library")
    ap.add_argument("--lib", help="nvc -L library path")
    ap.add_argument("--top", help="elaborated top unit (stage 3/4)")
    ap.add_argument("--nvc", default="nvc", help="nvc binary")
    ap.add_argument("--run", action="store_true", help="stage 3 dry-run")
    ap.add_argument("--verify", action="store_true", help="stage 4 probes")
    ap.add_argument("--stop-time", default="500ns")
    ap.add_argument("--run-timeout", type=int, default=1800)
    ap.add_argument("--json", help="write machine-readable report")
    ap.add_argument("--mem-bit-limit", type=int, default=65536)
    args = ap.parse_args()

    rep = Report()
    stage0(rep, args)
    stage1(rep, args)
    stage2(rep, args, which_yosys())
    if args.run:
        if not args.top:
            print("--run requires --top", file=sys.stderr)
            return 3
        stage3(rep, args)
    if args.verify:
        if not args.top:
            print("--verify requires --top", file=sys.stderr)
            return 3
        stage4(rep, args)

    rc = rep.finalize()
    rep.print_text()
    if args.json:
        with open(args.json, "w") as f:
            json.dump(rep.to_json(), f, indent=2)
    return rc


if __name__ == "__main__":
    sys.exit(main())
