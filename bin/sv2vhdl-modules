#!/bin/bash
#
# sv2vhdl-modules — Per-module Verilog-to-VHDL translation
#
# Translates each Verilog module individually, emitting VHDL entity+
# architecture for modules that succeed and stub entities with
# foreign architecture attributes for modules that fail.
#
# Usage: sv2vhdl-modules [options] input.sv -o output.vhd
#
# Options:
#   -I dir          Include directory (passed to iverilog)
#   --top module    Top module name (emitted last)
#   --log file      Append iverilog's output (stdout and stderr) for every
#                   module to <file>. Default with -o: iverilog.log next to
#                   the output file, started afresh. Without -o or --log the
#                   output is discarded.
#
# The log is a sequence of sections, one per iverilog run:
#   === sv2vhdl-modules: iverilog -tvhdl -s <module>: <status>
#   <iverilog's output for that run>
# where <status> is "translated", "deferred (iverilog exit <rc>)",
# "deferred (timed out after <n> s)", "deferred (<n> error(s) from the VHDL
# back end, which exited 0)" or "deferred (no VHDL written)".
# A module that ends deferred also gets its section echoed on stderr.
#
# A run that exits 0 but reports an error is not a translation: tgt-vhdl says
# some errors on stderr and goes on without the statement it could not draw
# ("Error: first arg to $set_val must be a signal": the always block's body is
# dropped, and the design simulates X).  Such a module is deferred like one
# whose run failed (BACKEND_ERROR_RE).
#
# Pipeline position:
#   iverilog -E | sv-normalize | sv2vhdl-modules > design.vhd
#

set -o pipefail

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
[[ "$SCRIPT_DIR" == "${BASH_SOURCE[0]}" ]] && SCRIPT_DIR="."

# Default to the BUILD-AREA iverilog + its plugin dir, so we validate what we
# build before installing. Falling back to a system `iverilog` with a stale
# -B silently fails every module's SV->VHDL translation -> port-less deferred
# stubs (a whole design that elaborates hollow). $IVERILOG / $IVL_BUILD_LIB
# still override. An $IVERILOG with no lib/ivl beside its bin/ (a wrapper
# script that passes its own -B, an iverilog on PATH) gets no -B here: the
# build area's plugins, which a -B here would name, overrode the wrapper's
# and silently translated with the shared vhdl.tgt.
_explicit_iverilog=${IVERILOG:+1}
if [[ -z "$IVERILOG" ]]; then
    if [[ -x /usr/local/src/iverilog/_install/bin/iverilog ]]; then
        IVERILOG=/usr/local/src/iverilog/_install/bin/iverilog
    else
        IVERILOG=iverilog
    fi
fi
if [[ -z "$IVL_BUILD_LIB" ]]; then
    _ivl_pfx="${IVERILOG%/bin/iverilog}"
    if [[ "$_ivl_pfx" != "$IVERILOG" && -d "$_ivl_pfx/lib/ivl" ]]; then
        IVL_BUILD_LIB="$_ivl_pfx/lib/ivl"
    elif [[ -n "$_explicit_iverilog" ]]; then
        IVL_BUILD_LIB=""
    elif [[ -d /usr/local/src/iverilog/_install/lib/ivl ]]; then
        IVL_BUILD_LIB=/usr/local/src/iverilog/_install/lib/ivl
    else
        IVL_BUILD_LIB=/usr/local/src/iverilog/build-lib
    fi
fi
IVL_FLAGS="${IVL_BUILD_LIB:+-B$IVL_BUILD_LIB}"
NVC_FLAGS="-psv2vhdl=1 -g2012"
# An error line in the output of an iverilog run: tgt-vhdl's "Error: ..." (on
# stderr, exit 0) and "VHDL conversion error: ...", or "<file>:<line>: error: ..."
BACKEND_ERROR_RE='^(Error|VHDL conversion error|[^ :]+:[0-9]+: error): '
OUTFILE=""
TOPMOD=""
INFILE=""
LOGFILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)     OUTFILE="$2"; shift 2 ;;
        --top)  TOPMOD="$2"; shift 2 ;;
        --log)  LOGFILE="$2"; shift 2 ;;
        -I*)    IVL_FLAGS="$IVL_FLAGS $1"; shift ;;
        -*)     shift ;;
        *)      INFILE="$1"; shift ;;
    esac
done

if [[ -z "$INFILE" ]]; then
    echo "Usage: sv2vhdl-modules input.sv -o output.vhd" >&2
    exit 1
fi

# iverilog's messages: an explicit --log is appended to (the caller owns it);
# the default one next to -o belongs to this run.
if [[ -z "$LOGFILE" && -n "$OUTFILE" ]]; then
    _odir="${OUTFILE%/*}"
    [[ "$_odir" == "$OUTFILE" ]] && _odir="."
    LOGFILE="$_odir/iverilog.log"
    : > "$LOGFILE"
fi
[[ -z "$LOGFILE" ]] && LOGFILE=/dev/null

WORKDIR=$(mktemp -d)
trap "rm -rf $WORKDIR" EXIT

# Extract module names (comments and strings stripped first: a module commented out with
# /* ... */ over several lines is no module -- ivtest pr1587634's `/* module top(); ... */'
# was translated as a top that iverilog cannot find -- and a "/*" in a string starts none)
MODULES=$(perl -0777 -pe 's{("(?:\\.|[^"\\\n])*")|(/\*.*?\*/)|(//[^\n]*)}{ defined $1 ? q("") : defined $2 ? do { my $c = $2; $c =~ tr/\n//cd; $c } : "" }gse' "$INFILE" \
          | grep "^module " | sed 's/module //; s/[( ;#].*//' | sort -u)
NMOD=$(echo "$MODULES" | wc -w)
echo "sv2vhdl-modules: found $NMOD modules" >&2

PASS=0
FAIL=0
STUB=0

# Translate each module
for mod in $MODULES; do
    [[ "$mod" == "__rtlmeter_utils" ]] && continue

    MODFILE="$WORKDIR/${mod}.vhd"
    MODLOG="$WORKDIR/${mod}.ivl.log"

    # Per-module translate timeout. Large modules like VeeR's veer_wrapper
    # take ~130s; 120s was too tight and silently deferred them to a
    # port-less stub (which a VHDL testbench then can't port-map). Allow
    # override via SV2VHDL_MOD_TIMEOUT; default raised to 600s.
    timeout "${SV2VHDL_MOD_TIMEOUT:-600}" "$IVERILOG" $IVL_FLAGS -tvhdl $NVC_FLAGS \
            -s "$mod" -o "$MODFILE" "$INFILE" > "$MODLOG" 2>&1
    rc=$?
    nerr=0
    [[ $rc -eq 0 ]] && nerr=$(grep -c -E "$BACKEND_ERROR_RE" "$MODLOG")
    if [[ $rc -eq 0 && $nerr -eq 0 && -s "$MODFILE" ]]; then
        STATUS="translated"
        # Rename helper entities by port-signature hash so cross-module
        # collisions (e.g. rvdff5 with different WIDTHs) become distinct
        # names. Leave the user's module name un-renamed so elaboration
        # commands stay stable.
        RENAMED="$WORKDIR/${mod}_renamed.vhd"
        if "${SCRIPT_DIR:-$(dirname "$0")}/sv-rename-variants" \
                "$MODFILE" -o "$RENAMED" --top "$mod" 2>/dev/null; then
            mv "$RENAMED" "$MODFILE"
        fi
        PASS=$((PASS + 1))
    else
        if [[ $rc -eq 124 ]]; then
            STATUS="deferred (timed out after ${SV2VHDL_MOD_TIMEOUT:-600} s)"
        elif [[ $rc -ne 0 ]]; then
            STATUS="deferred (iverilog exit $rc)"
        elif [[ $nerr -gt 0 ]]; then
            STATUS="deferred ($nerr error(s) from the VHDL back end, which exited 0)"
        else
            STATUS="deferred (no VHDL written)"
        fi
        FAIL=$((FAIL + 1))
        rm -f "$MODFILE"    # a killed run may leave part of a file behind
        MODFILE=""
    fi
    {
        echo "=== sv2vhdl-modules: iverilog -tvhdl -s $mod: $STATUS"
        cat "$MODLOG"
    } >> "$LOGFILE"

    # Generate stub for failed modules
    if [[ -z "$MODFILE" ]]; then
        echo "sv2vhdl-modules: module $mod: $STATUS; iverilog said:" >&2
        if [[ -s "$MODLOG" ]]; then
            sed 's/^/    /' "$MODLOG" >&2
        else
            echo "    (nothing)" >&2
        fi
        MODFILE="$WORKDIR/${mod}_stub.vhd"
        # Extract port declarations from the Verilog source
        # For now, emit a minimal stub — the foreign plugin will
        # do the real compilation at elaboration time
        # Extract ports from the translated modules that reference this one,
        # or emit a port-less stub. The deferred plugin will replace it.
        cat > "$MODFILE" << STUBEOF
-- Deferred compilation stub for module $mod
-- Source: $INFILE
library ieee;
use ieee.std_logic_1164.all;
library sv2vhdl;
use sv2vhdl.logic3d_types_pkg.all;

entity ${mod} is
  -- sv2vhdl:deferred source=${INFILE} module=${mod}
end entity;

architecture stub of ${mod} is
begin
  -- Deferred: will be compiled with concrete parameters at elaboration time
end architecture;
STUBEOF
        STUB=$((STUB + 1))
    fi
done

echo "sv2vhdl-modules: $PASS translated, $FAIL failed ($STUB stubs)" >&2

# Concatenate all VHDL files (stubs first, then translated, top last)
{
    # Stubs first
    for f in "$WORKDIR"/*_stub.vhd; do
        [[ -f "$f" ]] && cat "$f" && echo
    done
    # Translated modules (not top)
    for f in "$WORKDIR"/*.vhd; do
        [[ "$f" == *_stub.vhd ]] && continue
        [[ -n "$TOPMOD" && "$f" == *"${TOPMOD}.vhd" ]] && continue
        [[ -f "$f" ]] && cat "$f" && echo
    done
    # Top module last
    if [[ -n "$TOPMOD" && -f "$WORKDIR/${TOPMOD}.vhd" ]]; then
        cat "$WORKDIR/${TOPMOD}.vhd"
    fi
} > "${OUTFILE:-/dev/stdout}"
