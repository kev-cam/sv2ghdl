#!/bin/bash
#
# vvp-sv2ghdl - vvp-compatible wrapper for NVC elaborate + run
#
# Reads metadata from iverilog-sv2ghdl output directory, elaborates and runs
# with NVC.  Filters NVC report output to match iverilog $display format.
# Designed to work with the iverilog test suite (vvp_reg.pl --suffix=-sv2ghdl).
#

set -o pipefail
export PATH="/usr/bin:/usr/local/bin:/bin:$PATH"

# NVC binary: use PATH unless overridden by environment
if [[ -z "$NVC" ]]; then
    if [[ -x /usr/local/src/nvc-build/bin/nvc ]]; then NVC=/usr/local/src/nvc-build/bin/nvc; else NVC=nvc; fi
fi

# Derive NVC library path from binary location.
# Build tree:  .../nvc-build/bin/nvc -> .../nvc-build/lib
# Installed:   /usr/local/bin/nvc   -> /usr/local/lib/nvc
if [[ -z "$NVC_LIBDIR" ]]; then
    _nvc_bin=$(command -v "$NVC" 2>/dev/null)
    if [[ -n "$_nvc_bin" ]]; then
        _nvc_bin=$(readlink -f "$_nvc_bin")
        _nvc_prefix="${_nvc_bin%/bin/nvc}"
        if [[ -d "$_nvc_prefix/lib/sv2vhdl" ]]; then
            NVC_LIBDIR="$_nvc_prefix/lib"
        elif [[ -d "$_nvc_prefix/lib/nvc/sv2vhdl" ]]; then
            NVC_LIBDIR="$_nvc_prefix/lib/nvc"
        else
            NVC_LIBDIR="$_nvc_prefix/lib/nvc"
        fi
    else
        NVC_LIBDIR="/usr/local/lib/nvc"
    fi
fi
RESOLVER="${NVC_LIBDIR}/sv2vhdl/libresolver.so"
# The sv_math_pkg foreign functions ($sqrt, $ln, $pow, $sin, $hypot, $rtoi, $dist_*, ...):
# without this library each of them stops the run ("foreign function sv_sqrt not found").
SV_MATH="${NVC_LIBDIR}/sv2vhdl/libsv_math.so"

# The resolver plugin's Python half, sv2vhdl_resolver.py.  The plugin looks for it only in
# its own directory, which in a build tree holds no copy (make install puts one next to the
# plugin); without it every run prints "resolver: ERROR - cannot import sv2vhdl_resolver"
# and Python's ModuleNotFoundError, and per-net resolution is off.  Look next to the plugin,
# then in the nvc source tree the build was configured from (its Makefile's abs_top_srcdir),
# then beside the build directory (vamos's NvcBackend does the same).
_resolver_py=""
for _d in "${NVC_LIBDIR}/sv2vhdl" \
          "$(sed -n 's/^abs_top_srcdir = //p' "${NVC_LIBDIR}/../Makefile" 2>/dev/null)/lib/sv2vhdl" \
          "$(dirname "$NVC_LIBDIR")/../nvc/lib/sv2vhdl"; do
    if [[ -f "$_d/sv2vhdl_resolver.py" ]]; then
        _resolver_py=$(cd "$_d" && pwd)     # absolute: the run happens after a cd
        break
    fi
done

# Parse arguments (vvp-compatible)
SIMDIR=""
ACCEL_REQ=""
PLUSARGS=()
for arg in "$@"; do
    case "$arg" in
        -n|-N|-compatible|-i|-v|-q|-s) ;;  # Silently accepted
        -V)
            echo "Icarus Verilog version 13.0 (sv2ghdl/nvc)"
            exit 0 ;;
        --accel)     ACCEL_REQ="auto" ;;            # accelerate (auto-pick leaves)
        --accel=*)   ACCEL_REQ="${arg#--accel=}" ;; # accelerate a named module
        -l*|-m*|-M*) ;;  # Silently ignored
        +*)          PLUSARGS+=("$arg") ;;  # Plusargs -> $test$plusargs in the sim
        *)
            if [[ -z "$SIMDIR" ]]; then
                SIMDIR="$arg"
            fi
            ;;
    esac
done

if [[ -z "$SIMDIR" || ! -d "$SIMDIR" ]]; then
    echo "vvp-sv2ghdl: not a directory: $SIMDIR" >&2
    exit 1
fi

if [[ ! -f "$SIMDIR/_metadata" ]]; then
    echo "vvp-sv2ghdl: no _metadata in $SIMDIR" >&2
    exit 1
fi

# Read metadata
source "$SIMDIR/_metadata"

if [[ -z "$TOP_ENTITY" ]]; then
    echo "vvp-sv2ghdl: no TOP_ENTITY in metadata" >&2
    exit 1
fi

# Use the VHDL standard from compilation stage (2040 for iverilog backend,
# 2008 for sv2ghdl.pl fallback)
STD="${NVC_STD:-2008}"

# --accel trigger. Either pass --accel[=<module>] to this wrapper, or set
# NVC_ACCEL in the environment (e.g. `export NVC_ACCEL=auto`) so unmodified
# build scripts get acceleration for free. nvc background-compiles the hot
# RTL via yosys and hot-patches it in mid-run; the sim never waits.
[[ -z "$ACCEL_REQ" && -n "$NVC_ACCEL" ]] && ACCEL_REQ="$NVC_ACCEL"
ACCEL_FLAG=""
RUN_TIMEOUT=30
if [[ -n "$ACCEL_REQ" ]]; then
    ACCEL_FLAG="--accel"
    RUN_TIMEOUT=0   # accel runs are real workloads; disable the test-suite timeout
    case "$ACCEL_REQ" in
        auto|1|yes|true|on) ;;                    # auto: nvc picks leaf instances
        *) export NVC_ACCEL_TOP="$ACCEL_REQ" ;;   # hint a specific DUT module
    esac
fi

# Run NVC from the simulation directory (where work/ library lives)
cd "$SIMDIR"

# Elaborate
timeout 30 $NVC --std="$STD" -L "$NVC_LIBDIR" -e "$TOP_ENTITY" 2>&1
if [[ $? -ne 0 ]]; then
    exit 1
fi

# Run with output filter
# NVC report format:  ** Note: 0ms+0: PASSED
#                        Process :main:_p0 at main.vhd:15
# iverilog format:    PASSED
#
# The awk filter extracts message text from ** Note lines, strips Process
# continuation lines, and routes warnings/errors to stderr.
# Load the resolver plugin if available (generates per-net resolution via Python), and the
# math library.  The resolver goes first: both export the $random generator (sv_random), and
# the first library loaded wins, so the design keeps the resolver's one design-wide seed.
PLUGINS=""
if [[ -f "$RESOLVER" ]]; then
    PLUGINS="$RESOLVER"
    export SV2VHDL_QUIET=1
    if [[ -n "$_resolver_py" ]]; then
        export PYTHONPATH="$_resolver_py${PYTHONPATH:+:$PYTHONPATH}"
    fi
fi
if [[ -f "$SV_MATH" ]]; then
    PLUGINS="${PLUGINS:+$PLUGINS,}$SV_MATH"
fi
LOAD_PLUGINS=""
[[ -n "$PLUGINS" ]] && LOAD_PLUGINS="--load=$PLUGINS"

nvc_log=$(mktemp)
trap 'rm -f "$nvc_log"' EXIT
timeout "$RUN_TIMEOUT" $NVC --std="$STD" -L "$NVC_LIBDIR" $LOAD_PLUGINS -r $ACCEL_FLAG "$TOP_ENTITY" "${PLUSARGS[@]}" > "$nvc_log" 2>&1
nvc_exit=$?
awk '
    /^\*\* Note: loading VHPI/  { next }
    /^\*\* Note: /    { sub(/^\*\* Note: [^:]*: /, ""); print; next }
    /^   Process /    { next }
    /^   Procedure /  { next }
    /^   Function .* at .+:[0-9]+$/ { next }   # trace of a report inside a function
    /^\*\* Debug: /   { next }
    /^\*\* (Warning|Error|Fatal): / { print > "/dev/stderr"; next }
    /^plugin loaded/  { next }
    /^Python /        { next }
    /^loaded /        { next }
    /^===.*===/       { next }
    /^---/            { next }
    /^region:/        { next }
    /^  instance:/    { next }
    /^    port /      { next }
    /^      drv=/     { next }
    /^Total /         { next }
    /^Nets /          { next }
    /^resolver:/      { next }
    /^Root:/          { next }
    /^Initial /       { next }
    { print }
' "$nvc_log"

# iverilog's VHDL backend ends simulation with a deliberate
# `report "SIMULATION FINISHED" severity failure;` so NVC exits non-zero
# even on success.  Match what vhdl_nvc_reg.pl does: treat that marker
# as a clean simulation end.
if [[ $nvc_exit -ne 0 ]] && grep -q "SIMULATION FINISHED" "$nvc_log"; then
    exit 0
fi
exit $nvc_exit
