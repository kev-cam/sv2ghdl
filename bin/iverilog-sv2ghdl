#!/bin/bash
#
# iverilog-sv2ghdl - iverilog-compatible wrapper for sv2ghdl + NVC
#
# Two-stage translation:
#   1. Try iverilog -tvhdl -psv2vhdl=1 (native VHDL backend with entity
#      instantiations for sv2vhdl primitives)
#   2. Fall back to sv2ghdl.pl (Perl translator) if that fails
#
# Designed to work with the iverilog test suite (vvp_reg.pl --suffix=-sv2ghdl).
#
# The output file (-o) is a directory containing translated VHDL, NVC's work
# library, and a _metadata file.  The test runner's "rm -rf ./vsim" cleans
# everything up between tests.
#
# iverilog's diagnostics from every stage are kept in <outdir>/iverilog.log,
# next to design.vhd, as "=== <tool>: <run>" sections (sv2vhdl-modules
# writes one "=== sv2vhdl-modules: iverilog -tvhdl -s <module>: <status>"
# section per module). Each module that ends as a deferred stub in
# design.vhd is reported on stderr with its section.
#
# A VHDL back end run that exits 0 but reports an error ("Error: ..." on
# stderr, "VHDL conversion error: ...") failed all the same: tgt-vhdl goes on
# without the statement it could not draw, and the design would simulate X.
# sv2vhdl-modules defers such a module; the whole-design and per-module stages
# below take such a run as failed (BACKEND_ERROR_RE).
#
# nvc's analysis of the module-by-module translation (stage 1a) can fail in a
# module the design does not use: sv2vhdl-modules translates every module on
# its own, also one that only an unused generate branch instantiates.  When
# the whole-design translation (stage 1) then analyses, nvc's stage-1a errors
# are not printed: they are kept in <outdir>/_mods_analysis.log, with the VHDL
# they cite as <outdir>/_mods_design.vhd, and under vamos a note names the
# modules they are in and says whether the design uses them.  When stage 1
# fails too, they are printed as before.
#

set -o pipefail
export PATH="/usr/bin:/usr/local/bin:/bin:$PATH"

# Resolve script directory using bash string ops (no external commands)
SCRIPT_DIR="${BASH_SOURCE[0]%/*}/.."
SV2GHDL="$SCRIPT_DIR/sv2ghdl.pl"

# Tool paths: prefer the BUILD-AREA binaries (validate what we build before
# install); fall back to PATH. $NVC / $IVERILOG still override.
if [[ -z "$NVC" ]]; then
    if [[ -x /usr/local/src/nvc-build/bin/nvc ]]; then
        NVC=/usr/local/src/nvc-build/bin/nvc
    else
        NVC=nvc
    fi
fi
if [[ -z "$IVERILOG" ]]; then
    if [[ -x /usr/local/src/iverilog/_install/bin/iverilog ]]; then
        IVERILOG=/usr/local/src/iverilog/_install/bin/iverilog
    else
        IVERILOG=iverilog
    fi
fi

# Several sv-normalize rewrites work around iverilog frontend limitations that a
# current iverilog no longer has, and that now do more harm than good:
#  - the chained-dynamic-index hoist (Rule 0/0b/0c, gotcha-c) is superseded by
#    native variable-prefix-index support (commit bb318c2be);
#  - Rule 1b's `assign struct.field` -> procedural rewrite is unnecessary (the
#    continuous form elaborates) and CREATES a proc-vs-continuous conflict when
#    the struct is also continuously driven (eh2_dec_tlu_top .tid).
# Probe the resolved iverilog ONCE (a variable prefix index errors on an
# unpatched build); if it has the modern frontend, disable both superseded
# rewrites so the core does the work. Each env var honours an explicit override.
if [[ -z "${SV_NORMALIZE_NO_CHAINED+x}" || -z "${SV_NORMALIZE_NO_STRUCT_ASSIGN+x}" ]]; then
    _vpx=$(mktemp -d)
    printf 'module _vpx; logic [3:0][7:0] a; integer r; wire [3:0] y = a[r][3:0]; endmodule\n' > "$_vpx/p.v"
    if "$IVERILOG" -g2012 -tnull -o /dev/null "$_vpx/p.v" >/dev/null 2>&1; then
        [[ -z "${SV_NORMALIZE_NO_CHAINED+x}" ]]       && export SV_NORMALIZE_NO_CHAINED=1
        [[ -z "${SV_NORMALIZE_NO_STRUCT_ASSIGN+x}" ]] && export SV_NORMALIZE_NO_STRUCT_ASSIGN=1
    fi
    rm -rf "$_vpx"
fi
# Rule 6 too: it rewrites a one-line `m[i][j] = v;' as `$set_val(m, i, j, v)', where
# v, a system-task argument, is evaluated at its own width (`m[i][j] = a + b' lost
# the carry, silently).  An iverilog that elaborates the chained select on the left
# (and tgt-vhdl stores at the select's width) needs no rewrite.
if [[ -z "${SV_NORMALIZE_NO_SET_VAL+x}" ]]; then
    _vpx=$(mktemp -d)
    printf 'module _vpx; reg [7:0] m [0:1]; integer i, j; initial m[i][j] = 1'"'"'b1; endmodule\n' > "$_vpx/p.v"
    if "$IVERILOG" -g2012 -tnull -o /dev/null "$_vpx/p.v" >/dev/null 2>&1; then
        export SV_NORMALIZE_NO_SET_VAL=1
    fi
    rm -rf "$_vpx"
fi

# Derive NVC library path from binary location.
# Build tree:  .../nvc-build/bin/nvc -> .../nvc-build/lib
# Installed:   /usr/local/bin/nvc   -> /usr/local/lib/nvc
if [[ -z "$NVC_LIBDIR" ]]; then
    _nvc_bin=$(command -v "$NVC" 2>/dev/null)
    if [[ -n "$_nvc_bin" ]]; then
        _nvc_bin=$(readlink -f "$_nvc_bin")
        _nvc_prefix="${_nvc_bin%/bin/nvc}"
        # Check build-tree layout first (lib/sv2vhdl/ sibling to bin/)
        if [[ -d "$_nvc_prefix/lib/sv2vhdl" ]]; then
            NVC_LIBDIR="$_nvc_prefix/lib"
        # Installed layout: /usr/local/lib/nvc/sv2vhdl/
        elif [[ -d "$_nvc_prefix/lib/nvc/sv2vhdl" ]]; then
            NVC_LIBDIR="$_nvc_prefix/lib/nvc"
        else
            NVC_LIBDIR="$_nvc_prefix/lib/nvc"
        fi
    else
        NVC_LIBDIR="/usr/local/lib/nvc"
    fi
fi

# Defaults
OUTPUT="a.out"
TOP_MODULE=""
TARGET="vvp"
SOURCES=()
IVL_INC=()      # -I include dirs, forwarded to iverilog
IVL_LIBDIR=()   # -y / +libdir+ library dirs, forwarded (their modules become sources)
IVL_LIBOPT=()   # -Y / +libext+ library extensions, forwarded
IVL_DEF=()      # -D defines, forwarded to iverilog
ORIG_DIR="$(pwd)"

# Parse arguments (iverilog-compatible)
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            OUTPUT="$2"; shift 2 ;;
        -s)
            TOP_MODULE="$2"; shift 2 ;;
        -t)
            TARGET="$2"; shift 2 ;;
        -V)
            echo "Icarus Verilog version 13.0 (sv2ghdl/nvc)"
            exit 0 ;;
        --two-state)
            # Match Verilator's X-free (2-state) semantics: collapse uncertain
            # logic3d literals in the generated VHDL to clean driven values (see
            # two_state_clean_vhdl below).  Exported so a downstream/child
            # iverilog-sv2ghdl invocation honours it too.
            export SV2VHDL_TWO_STATE=1; shift ;;
        -g*)    shift ;;   # Generation flags - ignored
        -D)     IVL_DEF+=("-D$2"); shift 2 ;;  # Define (separate arg)
        -D*)    IVL_DEF+=("$1");   shift ;;    # Define - forward to iverilog
        -I)     IVL_INC+=("-I$2"); shift 2 ;;  # Include dir (separate arg)
        -I*)    IVL_INC+=("$1");   shift ;;    # Include path - forward to iverilog
        -P*)    shift ;;   # Parameter overrides - ignored
        -W*)    shift ;;   # Warnings - ignored
        -S)     shift ;;   # Synthesize - ignored
        -v)     shift ;;   # Verbose - ignored
        -u)     shift ;;   # Separate compilation units - ignored
        -m)     shift 2 ;; # Module - ignored
        -m*)    shift ;;
        -L)     shift 2 ;; # Library path - ignored
        -L*)    shift ;;
        # Library dirs and extensions: forwarded, and the modules iverilog
        # resolves from them join the sources (see "library modules" below)
        -y)     IVL_LIBDIR+=("$2"); shift 2 ;;
        -y*)    IVL_LIBDIR+=("${1#-y}"); shift ;;
        -Y)     IVL_LIBOPT+=("-Y$2"); shift 2 ;;
        -Y*)    IVL_LIBOPT+=("$1"); shift ;;
        +libdir+*) IFS='+' read -r -a _dirs <<< "${1#+libdir+}"
                   for _d in "${_dirs[@]}"; do [[ -n "$_d" ]] && IVL_LIBDIR+=("$_d"); done
                   shift ;;
        +libext+*) IVL_LIBOPT+=("$1"); shift ;;
        +*)     shift ;;   # Other plusargs - ignored
        -B)     shift 2 ;; # Tool path - ignored
        -B*)    shift ;;
        -p*)    shift ;;   # Compiler param - ignored
        -E)     shift ;;   # Preprocess only - ignored
        -*)     shift ;;   # Any other flag - ignored
        *)
            SOURCES+=("$1"); shift ;;
    esac
done

# In --two-state mode, collapse UNCERTAIN logic3d literals in the generated VHDL
# to clean driven values (Verilator's X->0 semantics), preserving the value bit:
#   L3D_X (X, val 0) -> L3D_0   L3D_U (U, val 1) -> L3D_1
#   L3D_Z (Z, val 0) -> L3D_0   L3D_W (W, val 1) -> L3D_1
# Rationale: behavioral SRAM models write `Q <= 'x` on read-during-write and read
# uninitialised entries; iverilog faithfully emits L3D_X for those. In 4-state that
# X propagates into fetch/control and wedges the pipe (VeeR-EH2 hello froze at
# cyc85); Verilator (2-state) never sees X because it maps 'x->0. Doing the same
# here makes --two-state match Verilator. Case-choice lines (`when L3D_x =>`) are
# skipped so a remap can't create duplicate `when` choices.
two_state_clean_vhdl() {
    [[ -n "${SV2VHDL_TWO_STATE:-}" ]] || return 0
    [[ -s "$1" ]] || return 0
    sed -i '/[[:space:]]when[[:space:]]/!{
        s/\bL3D_X\b/L3D_0/g
        s/\bL3D_U\b/L3D_1/g
        s/\bL3D_Z\b/L3D_0/g
        s/\bL3D_W\b/L3D_1/g
    }' "$1"
}

if [[ ${#SOURCES[@]} -eq 0 ]]; then
    echo "iverilog-sv2ghdl: no source files" >&2
    exit 1
fi

# Convert source paths to absolute before we cd
ABS_SOURCES=()
for src in "${SOURCES[@]}"; do
    case "$src" in
        /*) ABS_SOURCES+=("$src") ;;
        *)  ABS_SOURCES+=("$ORIG_DIR/$src") ;;
    esac
done

# Convert -I include dirs to absolute too — the iverilog calls below run after
# a cd into the output dir, so relative include paths would otherwise break.
ABS_INC=()
for inc in "${IVL_INC[@]}"; do
    dir="${inc#-I}"
    case "$dir" in
        /*) ABS_INC+=("-I$dir") ;;
        *)  ABS_INC+=("-I$ORIG_DIR/$dir") ;;
    esac
done

# Library dirs (-y, +libdir+) to absolute too, for the same reason.
ABS_LIB=()
for dir in "${IVL_LIBDIR[@]}"; do
    case "$dir" in
        /*) ABS_LIB+=("-y$dir") ;;
        *)  ABS_LIB+=("-y$ORIG_DIR/$dir") ;;
    esac
done
ABS_LIB+=("${IVL_LIBOPT[@]}")

# Output directory (replaces the normal output file)
# The test runner's "rm -rf ./vsim" cleans this up between tests.
case "$OUTPUT" in
    /*) OUTDIR="$OUTPUT" ;;
    *)  OUTDIR="$ORIG_DIR/$OUTPUT" ;;
esac
rm -rf "$OUTDIR"
mkdir -p "$OUTDIR"

# iverilog's messages: one "=== iverilog-sv2ghdl: <run>" section per run
IVL_LOG="$OUTDIR/iverilog.log"
: > "$IVL_LOG"
ivl_log_section() { echo "=== iverilog-sv2ghdl: $*" >> "$IVL_LOG"; }

# Library modules (-y): the preprocess stage below runs on the listed sources
# only, and iverilog -E drops the `define directives it consumed, so a library
# file that uses the design's macros cannot be parsed later from the library
# (ivtest macro_args: "macro BAR undefined" at the library file). Ask iverilog
# which library files this design resolves (-M module=) and translate them as
# sources, after the files that define the macros, as iverilog itself does.
if [[ ${#ABS_LIB[@]} -gt 0 ]]; then
    _deps="$OUTDIR/.libdeps"
    ivl_log_section "iverilog -tnull -M module= (resolve -y library modules)"
    if "$IVERILOG" -tnull -g2012 "${ABS_INC[@]}" "${IVL_DEF[@]}" "${ABS_LIB[@]}" \
            -M "module=$_deps" -o /dev/null "${ABS_SOURCES[@]}" 2>>"$IVL_LOG" \
       && [[ -s "$_deps" ]]; then
        while IFS= read -r _f; do
            [[ -n "$_f" ]] || continue
            case "$_f" in /*) ;; *) _f="$ORIG_DIR/$_f" ;; esac
            _seen=0
            for _s in "${ABS_SOURCES[@]}"; do [[ "$_s" == "$_f" ]] && { _seen=1; break; }; done
            [[ $_seen -eq 0 && -f "$_f" ]] && ABS_SOURCES+=("$_f")
        done < "$_deps"
    fi
fi

# An error line in the output of a VHDL back end run (see the header):
# tgt-vhdl's "Error: ..." and "VHDL conversion error: ...", or
# "<file>:<line>: error: ..." (sv2vhdl-modules has the same rule)
BACKEND_ERROR_RE='^(Error|VHDL conversion error|[^ :]+:[0-9]+: error): '

# ivl_run <section> <command...>: run a VHDL back end command with its stderr
# in its own section of iverilog.log.  Fails when the command fails, and when
# it exits 0 but reports an error (BACKEND_ERROR_RE), which the section notes.
ivl_run() {
    local sect="$1" err="$OUTDIR/.ivl_run.err" rc n
    shift
    ivl_log_section "$sect"
    "$@" 2>"$err"
    rc=$?
    cat "$err" >> "$IVL_LOG"
    n=$(grep -c -E "$BACKEND_ERROR_RE" "$err")
    if [[ $rc -eq 0 && $n -gt 0 ]]; then
        echo "iverilog-sv2ghdl: $n error(s) from the VHDL back end, which exited 0: this run failed" >> "$IVL_LOG"
        rc=1
    fi
    rm -f "$err"
    return $rc
}

# Stage 1a's nvc analysis (see the header): its output, and the VHDL it cites
MODS_NVC_LOG="$OUTDIR/_mods_analysis.log"
MODS_VHD="$OUTDIR/_mods_design.vhd"
MODS_FAILED=""

# mods_failed_units: "<module>\t<line>\t<nvc's message>" for each Verilog module
# whose VHDL in $MODS_VHD an error of $MODS_NVC_LOG cites (the first error per
# module), from the "-- Generated from Verilog module" comments tgt-vhdl puts
# before each design unit
mods_failed_units() {
    awk '
        FNR == NR {
            if ($0 ~ /^\*\* (Error|Fatal|Failure): /) {
                msg = $0; sub(/^\*\* (Error|Fatal|Failure): /, "", msg)
            } else if (msg != "" && $0 ~ /^[ \t]*> .*_mods_design\.vhd:[0-9]+[ \t]*$/) {
                l = $0; sub(/^.*:/, "", l); l += 0
                if (!(l in want)) want[l] = msg
                msg = ""
            }
            next
        }
        /^-- Generated from Verilog module / {
            cur = $0; sub(/^-- Generated from Verilog module /, "", cur); sub(/[ \t(].*$/, "", cur)
        }
        (FNR in want) && cur != "" && !(cur in seen) {
            seen[cur] = 1; print cur "\t" FNR "\t" want[FNR]
        }' "$MODS_NVC_LOG" "$MODS_VHD"
}

# mods_failure_note: stage 1a's analysis failed and stage 1's passed.  Into
# iverilog.log, and under vamos (which shows the translator's output) a note on
# stderr: each module nvc's errors are in, and whether the design uses it (its
# whole-design translation has it).
mods_failure_note() {
    local mod line msg how n=0
    ivl_log_section "nvc -a of the module-by-module translation failed; the whole-design translation was used"
    cat "$MODS_NVC_LOG" >> "$IVL_LOG"
    while IFS=$'\t' read -r mod line msg; do
        n=$((n + 1))
        if grep -q -F -- "-- Generated from Verilog module $mod (" "$VHDL_OUT"; then
            how="the module-by-module translation of module $mod does not analyse (nvc: $msg, $MODS_VHD:$line); the whole-design translation, which analyses, was used"
        else
            how="module $mod, which the design does not use, does not translate on its own (nvc: $msg, $MODS_VHD:$line); it is left out"
        fi
        echo "iverilog-sv2ghdl: note: $how" >> "$IVL_LOG"
        [[ -n "$VAMOS_STACK" ]] && echo "iverilog-sv2ghdl: note: $how" >&2
    done < <(mods_failed_units)
    if [[ $n -eq 0 && -n "$VAMOS_STACK" ]]; then
        echo "iverilog-sv2ghdl: note: nvc could not analyse the module-by-module translation (see $MODS_NVC_LOG); the whole-design translation, which analyses, was used" >&2
    fi
}

# --- Stage 0: preprocess + normalize ---
# The iverilog tgt-vhdl elaborator rejects some SystemVerilog the VeeR-class
# RTL uses (notably chained dynamic-then-range indexing `arr[VAR][HI:LO]`).
# sv-normalize rewrites those into translatable equivalents. The intended
# pipeline is `iverilog -E | sv-normalize | (translate)`, so do that here and
# feed the single normalized file to both stage 1 and the stage-2 split.
SV_NORMALIZE="${BASH_SOURCE[0]%/*}/sv-normalize"
NORM_SRC=""
if [[ -x "$SV_NORMALIZE" ]]; then
    _pp="$OUTDIR/_pp.v"
    _norm="$OUTDIR/_norm.sv"
    ivl_log_section "iverilog -E (preprocess)"
    if "$IVERILOG" -E -g2012 "${ABS_INC[@]}" "${IVL_DEF[@]}" "${ABS_LIB[@]}" \
            -o "$_pp" "${ABS_SOURCES[@]}" 2>>"$IVL_LOG" \
       && [[ -s "$_pp" ]] \
       && "$SV_NORMALIZE" < "$_pp" > "$_norm" 2>/dev/null \
       && [[ -s "$_norm" ]]; then
        NORM_SRC="$_norm"
    fi
fi
# If normalization succeeded, translate the normalized file; otherwise fall
# back to the raw sources (preserves previous behaviour for simple inputs).
if [[ -n "$NORM_SRC" ]]; then
    XLAT_SOURCES=("$NORM_SRC")
else
    XLAT_SOURCES=("${ABS_SOURCES[@]}")
fi

IVERILOG_OK=0
VHDL_OUT="$OUTDIR/design.vhd"

# --- Stage 1a: sv2vhdl-modules on the normalized source ---
# sv2vhdl-modules does robust per-module translation (keeping each module's
# context) and emits a single combined design.vhd. This is the pipeline that
# translates whole VeeR-class designs; prefer it when we have a normalized
# source and the tool is available.
SV2VHDL_MODULES="${BASH_SOURCE[0]%/*}/sv2vhdl-modules"
SV_DEDUP="${BASH_SOURCE[0]%/*}/sv-dedup-vhdl"
if [[ -n "$NORM_SRC" && -x "$SV2VHDL_MODULES" ]]; then
    _mods="$OUTDIR/_mods.vhd"
    if IVERILOG="$IVERILOG" "$SV2VHDL_MODULES" "$NORM_SRC" -o "$_mods" \
            --log "$IVL_LOG" 2>/dev/null \
            && [[ -s "$_mods" ]]; then
        # sv2vhdl-modules emits each parameterised helper (rvdff, rvdffe, ...)
        # once per referencing module; the same __hash variant therefore
        # appears many times. Deduplicate identical entity/architecture
        # definitions so NVC sees each variant once.
        if [[ -x "$SV_DEDUP" ]] && "$SV_DEDUP" < "$_mods" > "$VHDL_OUT" 2>/dev/null \
                && [[ -s "$VHDL_OUT" ]]; then
            :
        else
            cp "$_mods" "$VHDL_OUT"
        fi
        two_state_clean_vhdl "$VHDL_OUT"
        cd "$OUTDIR"
        if $NVC -M 2g -H 1g --std=2040 -L "$NVC_LIBDIR" -a "$VHDL_OUT" > "$MODS_NVC_LOG" 2>&1; then
            cat "$MODS_NVC_LOG"
            rm -f "$MODS_NVC_LOG"
            IVERILOG_OK=1
            echo "SV2VHDL_MODULES=1" >> "$OUTDIR/_metadata.tmp"
        else
            # kept, citing the VHDL as $MODS_VHD, until stage 1 has run (see the header)
            MODS_FAILED=1
            mv "$VHDL_OUT" "$MODS_VHD"
            awk -v a="$VHDL_OUT:" -v b="$MODS_VHD:" '{
                    out = ""; s = $0
                    while ((i = index(s, a)) > 0) { out = out substr(s, 1, i - 1) b; s = substr(s, i + length(a)) }
                    print out s }' "$MODS_NVC_LOG" > "$MODS_NVC_LOG.tmp" \
                && mv "$MODS_NVC_LOG.tmp" "$MODS_NVC_LOG"
        fi
        cd "$ORIG_DIR"
    fi
fi

# --- Stage 1: Try iverilog -tvhdl -psv2vhdl=1 ---
# Produces a single VHDL file with entity instantiations for sv2vhdl
# primitives.  Uses --std=2040 for NVC compilation.

WHOLE_NVC_LOG="$OUTDIR/.whole_analysis.log"
if [[ $IVERILOG_OK -eq 0 ]] && \
   ivl_run "iverilog -tvhdl (whole design)" \
       timeout 30 "$IVERILOG" -tvhdl -psv2vhdl=1 -g2012 "${ABS_INC[@]}" "${IVL_DEF[@]}" "${ABS_LIB[@]}" -o "$VHDL_OUT" "${XLAT_SOURCES[@]}"; then
    if [[ -s "$VHDL_OUT" ]]; then
        two_state_clean_vhdl "$VHDL_OUT"
        # Compile with NVC (--std=2040 for sv2vhdl library + STD_MX features)
        cd "$OUTDIR"
        if $NVC -M 2g -H 1g --std=2040 -L "$NVC_LIBDIR" -a "$VHDL_OUT" > "$WHOLE_NVC_LOG" 2>&1; then
            IVERILOG_OK=1
            echo "IVERILOG_BACKEND=1" >> "$OUTDIR/_metadata.tmp"
        fi
    fi
fi

# Stage 1a's analysis errors: a note when stage 1 analysed, else printed (ahead of
# stage 1's own, as they always came)
if [[ -n "$MODS_FAILED" ]]; then
    if [[ $IVERILOG_OK -eq 1 ]]; then
        mods_failure_note
    else
        cat "$MODS_NVC_LOG"
    fi
fi
if [[ -f "$WHOLE_NVC_LOG" ]]; then
    cat "$WHOLE_NVC_LOG"
    rm -f "$WHOLE_NVC_LOG"
fi

# --- Stage 2: Try iverilog per-module ---
# Split the source into individual modules and try iverilog on each one.
# This handles files where some modules translate but others don't.

if [[ $IVERILOG_OK -eq 0 ]]; then
    rm -f "$VHDL_OUT"
    rm -rf "$OUTDIR/work"

    SPLIT_DIR="$OUTDIR/_split"
    mkdir -p "$SPLIT_DIR"
    MODULES_OK=0
    MODULES_FAIL=0

    # Collect defines/timescale/includes across ALL source files into a
    # shared preamble, then split each file's modules into individual .v
    # files with that preamble prepended.  This mirrors Verilog's "one long
    # stream" compilation model where `defines are sticky.
    PREAMBLE_FILE="$SPLIT_DIR/_preamble.v"
    : > "$PREAMBLE_FILE"

    for src in "${XLAT_SOURCES[@]}"; do
        awk '
            /^\s*`timescale/ { print >> "'"$PREAMBLE_FILE"'"; next }
            /^\s*`define/    { print >> "'"$PREAMBLE_FILE"'"; next }
            /^\s*`include/   { print >> "'"$PREAMBLE_FILE"'"; next }
            /^\s*module\s+/ {
                if (out) close(out)
                match($0, /module\s+([a-zA-Z_][a-zA-Z0-9_]*)/, m)
                modname = m[1]
                out = "'"$SPLIT_DIR"'/" modname ".v"
                system("cat '"$PREAMBLE_FILE"' > " out)
            }
            { if (out) print >> out }
        ' "$src"
    done

    # Try iverilog on each module, validate with nvc -a, fall back to sv2ghdl.pl
    cd "$OUTDIR"
    for mod_v in "$SPLIT_DIR"/*.v; do
        [[ -f "$mod_v" ]] || continue
        modname="${mod_v##*/}"
        modname="${modname%.v}"
        [[ "$modname" == "_preamble" ]] && continue
        mod_vhd="$OUTDIR/${modname}.vhd"

        if ivl_run "iverilog -tvhdl $modname (per-module fallback)" \
                timeout 30 "$IVERILOG" -tvhdl -psv2vhdl=1 -g2012 "${ABS_INC[@]}" "${IVL_DEF[@]}" "${ABS_LIB[@]}" \
                -o "$mod_vhd" "$mod_v" \
                && [[ -s "$mod_vhd" ]] \
                && $NVC --std=2040 -L "$NVC_LIBDIR" -a "$mod_vhd" >/dev/null 2>&1; then
            MODULES_OK=$((MODULES_OK + 1))
        else
            # iverilog failed or produced invalid VHDL — try sv2ghdl.pl
            rm -f "$mod_vhd"
            if "$SV2GHDL" "$mod_v" -o "$mod_vhd" 2>/dev/null \
                    && [[ -s "$mod_vhd" ]] \
                    && $NVC --std=2040 -L "$NVC_LIBDIR" -a "$mod_vhd" >/dev/null 2>&1; then
                MODULES_OK=$((MODULES_OK + 1))
            else
                rm -f "$mod_vhd"
                MODULES_FAIL=$((MODULES_FAIL + 1))
            fi
        fi
    done

    rm -rf "$SPLIT_DIR"

    if [[ $MODULES_OK -eq 0 ]]; then
        echo "iverilog-sv2ghdl: no modules translated" >&2
        exit 1
    fi
fi

# A module left as a deferred stub in design.vhd (sv2vhdl-modules could not
# translate it) elaborates as an empty entity: say so on stderr, with what
# iverilog said when it tried.
if [[ -s "$VHDL_OUT" ]]; then
    for _dm in $(grep -o 'sv2vhdl:deferred source=.* module=[A-Za-z0-9_$]*' "$VHDL_OUT" \
                 | sed 's/.* module=//' | sort -u); do
        echo "iverilog-sv2ghdl: module $_dm was not translated (a deferred stub in design.vhd); iverilog said:" >&2
        awk -v hdr="=== sv2vhdl-modules: iverilog -tvhdl -s $_dm: " '
            index($0, hdr) == 1 { on = 1; next }
            /^=== /             { on = 0 }
            on                  { print "    " $0; n++ }
            END                 { if (!n) print "    (nothing)" }' "$IVL_LOG" >&2
    done
fi

# For -t null (CN tests), compilation is all we need
if [[ "$TARGET" == "null" ]]; then
    exit 0
fi

# Determine top entity. Auto-detect the RTL root: the top module is the one
# nothing else instantiates, so (with comments stripped) its name occurs only
# in its own `module <name>` declaration, while instantiated modules occur >=2
# times. Pick the unique minimum-occurrence module; fall back to the first
# module of the last source file if that's ambiguous.
if [[ -z "$TOP_MODULE" ]]; then
    # (a block comment over several lines too: pr1587634's `/* module top(); ... */'; and
    # strings, whose words are no references: scope2's "main.test.q" tied main with test)
    _src=$(cat "${ABS_SOURCES[@]}" 2>/dev/null \
           | perl -0777 -pe 's{("(?:\\.|[^"\\\n])*")|(/\*.*?\*/)|(//[^\n]*)}{ defined $1 ? q("") : defined $2 ? do { my $c = $2; $c =~ tr/\n//cd; $c } : "" }gse')
    _decl=$(printf '%s\n' "$_src" | grep -oP '^\s*(?:\(\*.*?\*\)\s*)*module\s+\K\w+' | sort -u)
    _best=""; _min=2147483647; _ties=0
    for _m in $_decl; do
        _c=$(printf '%s\n' "$_src" | grep -owE "$_m" | wc -l)
        if   (( _c < _min ));  then _min=$_c; _best="$_m"; _ties=1
        elif (( _c == _min )); then _ties=$((_ties + 1)); fi
    done
    (( _ties == 1 )) && TOP_MODULE="$_best"
fi
if [[ -z "$TOP_MODULE" ]]; then
    LAST_SOURCE="${ABS_SOURCES[${#ABS_SOURCES[@]}-1]}"
    TOP_MODULE=$(grep -m1 -oP '^\s*(?:\(\*.*?\*\)\s*)*module\s+\K\w+' "$LAST_SOURCE" 2>/dev/null)
fi

if [[ -z "$TOP_MODULE" ]]; then
    echo "iverilog-sv2ghdl: cannot determine top module" >&2
    exit 1
fi

# A top module left as a deferred stub has nothing to simulate: the run would end at
# once, with no output and exit 0, and the reason would show only above and in
# iverilog.log.  Fail the compile, as iverilog fails on a design it cannot elaborate
# (ivtest's compile-error tests count on that).  Under vamos (VAMOS_STACK) the
# translation stays, and vamos reports the stub itself, quoting iverilog's reason.
if [[ -z "$VAMOS_STACK" && -s "$VHDL_OUT" ]] \
        && grep -q -E "sv2vhdl:deferred source=.* module=${TOP_MODULE}\$" "$VHDL_OUT"; then
    echo "iverilog-sv2ghdl: the top module $TOP_MODULE was not translated (a deferred stub; see above)" >&2
    exit 1
fi

# Under vamos (VAMOS_STACK is set; vamos shows the translator's output),
# tgt-vhdl's warnings about connections it does not translate faithfully --
# a part-select tran or an inout concatenation part connected one way only,
# a tri1/tri0 pull with nothing to sit on, a construct "not translated" --
# are said on stderr, not only in iverilog.log. Only those of the run that
# translated the top module (or the whole design) count: every module's own
# elaboration-root run also warns about its root ports, which the design
# does not have. (The ivtest harness compares this script's output with gold
# files, so it stays silent there.)
if [[ -n "$VAMOS_STACK" && -s "$IVL_LOG" ]]; then
    awk -v hdr="=== sv2vhdl-modules: iverilog -tvhdl -s $TOP_MODULE: " '
        /^=== / { on = (index($0, hdr) == 1 \
                        || index($0, "=== iverilog-sv2ghdl: iverilog -tvhdl (whole design)") == 1)
                  next }
        on && /^Warning: / && /connected one way only|not translated/ {
            if (!seen[$0]++) print "iverilog-sv2ghdl: " $0 }' "$IVL_LOG" >&2
fi

# The entity of the top module: tgt-vhdl renames a module whose name is a VHDL
# reserved word (pipe -> pipe_module__50dc, loop, view, ...); the "-- Generated
# from Verilog module <m> (...)" comment right above the entity keeps the Verilog
# name.  The last such entity (a translation run writes its root last); the module
# name itself when there is none (`nvc -e pipe' found no unit WORK.PIPE).
TOP_ENTITY="$TOP_MODULE"
if [[ -s "$VHDL_OUT" ]]; then
    _ent=$(awk -v m="$TOP_MODULE" '
        /^-- Generated from Verilog module / { cur = $6; next }
        /^--/                                { next }
        /^[ \t]*entity[ \t]+[A-Za-z0-9_]+[ \t]+is/ {
            if (cur == m) { e = $0; sub(/^[ \t]*entity[ \t]+/, "", e); sub(/[ \t].*$/, "", e); found = e }
        }
        { cur = "" }
        END { if (found != "") print found }' "$VHDL_OUT")
    [[ -n "$_ent" ]] && TOP_ENTITY="$_ent"
fi

# Write metadata for vvp-sv2ghdl (with what the stages recorded on the way,
# SV2VHDL_MODULES=1 / IVERILOG_BACKEND=1; _metadata.tmp keeps them too)
{
    echo "TOP_ENTITY=\"$TOP_ENTITY\""
    if [[ $IVERILOG_OK -eq 1 ]]; then
        echo "NVC_STD=\"2040\""
    else
        echo "NVC_STD=\"2040\""
    fi
    [[ -s "$OUTDIR/_metadata.tmp" ]] && cat "$OUTDIR/_metadata.tmp"
} > "$OUTDIR/_metadata"

exit 0
